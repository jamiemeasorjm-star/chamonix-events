var CAT_COLORS = {"Cinema": "cC", "concert": "cE", "exhibition": "cE", "family": "cF", "market": "cM", "other": "cP", "sport": "cS", "theatre": "cT"};
var CAT_LABELS = {"Cinema": "Cinema", "concert": "Concert", "exhibition": "Exposition", "family": "Famille", "market": "Marche", "other": "Autre", "sport": "Sport", "theatre": "Theatre"};

var today=new Date(),tom=new Date(today);tom.setDate(tom.getDate()+1);
var todayS=today.toISOString().split("T")[0],tomS=tom.toISOString().split("T")[0];
var map=null,markerGroup=null;

function fmt(d){if(!d)return null;try{var dt=new Date(d);if(isNaN(dt.getTime()))return null;return{date:dt,day:t("d"+dt.getDay()),dayNum:dt.getDate(),month:t("m"+dt.getMonth()),iso:dt.toISOString().split("T")[0],display:String(dt.getDate()).padStart(2,"0")+"/"+String(dt.getMonth()+1).padStart(2,"0")+"/"+dt.getFullYear()};}catch{return null}}
function catLabel(cat){return CAT_LABELS[cat]||t("cat_"+cat)||cat}
function catColor(cat){return CAT_COLORS[cat]||""}
function esc(s){return s?s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"):""}
function strip(s){return s?s.replace(/<[^>]*>/g,""):""}
function evId(e){return e.id||"ev-"+EVENTS.indexOf(e)}

function getEventVenue(e){
  if(e.venue)return e.venue;
  var addr=e.address||"";
  if(addr.indexOf("Place du Mont-Blanc")>=0)return"Place du Mont-Blanc";
  if(!addr)return"";
  var raw=addr.split(/\d+/)[0].trim().replace(/\s+/g," ").replace(/[-,]+$/,"").trim();
  if(raw.indexOf("Eglise")>=0)return"Eglise Saint-Michel";if(raw.indexOf("Presbytere")>=0)return"Presbytere Saint-Michel";
  if(raw.indexOf("Musee")>=0||raw.indexOf("Cristaux")>=0)return"Musee des Cristaux";if(raw.indexOf("Observatoire")>=0)return"Observatoire du Mont-Blanc";
  if(raw.indexOf("Centre sportif")>=0)return"Centre sportif Richard Bozon";if(raw.indexOf("Tennis")>=0)return"Tennis de Chamonix";
  if(raw.indexOf("Ferme")>=0||raw.indexOf("Pain")>=0)return"La ferme du Pain de Chibon";if(raw.indexOf("Chavants")>=0)return"Lac des Chavants";
  if(raw.indexOf("Gaillands")>=0)return"Lac des Gaillands";if(raw.indexOf("Mairie")>=0)return"Mairie Les Houches";
  if(raw.indexOf("Argentiere")>=0)return"Maison de Village d'Argentiere";if(raw.indexOf("Pre")>=0||raw.indexOf("Servoz")>=0)return"Pre de l'Eglise";
  if(raw.indexOf("Espace Animation")>=0)return"Espace Animation";if(raw.indexOf("Espace Michel")>=0||raw.indexOf("EMC")>=0)return"Espace Michel Croz";
  return raw;
}

function getVenueCoords(vname){
  if(!vname)return null;
  for(var i=0;i<VENUES.length;i++){if(VENUES[i].key===vname||VENUES[i].name===vname){if(VENUES[i].lat&&VENUES[i].lng)return[VENUES[i].lat,VENUES[i].lng];}}
  return null;
}

function toggleMap(){
  var btn=document.getElementById("map-toggle");
  var grid=document.getElementById("ev-grid");
  var mc=document.getElementById("map-container");
  var isMap=btn.dataset.view==="map";
  if(isMap){
    btn.dataset.view="grid";btn.classList.remove("on");btn.textContent=t("map_btn");
    grid.classList.remove("hidden");mc.classList.remove("show");
  }else{
    btn.dataset.view="map";btn.classList.add("on");btn.textContent=t("grid_btn");
    grid.classList.add("hidden");mc.classList.add("show");
    if(!map){initMap();}
    updateMapMarkers();
  }
}

function initMap(){
  if(typeof L==="undefined")return;
  map=L.map("map-container",{zoomControl:false,attributionControl:true}).setView([45.92,6.87],13);
  L.tileLayer("https://{s}.basemaps.cartocdn.com/light_all/{z}/{x}/{y}{r}.png",{attribution:'&copy; <a href="https://www.openstreetmap.org/copyright">OSM</a> &copy; <a href="https://carto.com/">CARTO</a>',subdomains:"abcd",maxZoom:19}).addTo(map);
  L.control.zoom({position:"bottomright"}).addTo(map);
  markerGroup=L.layerGroup().addTo(map);
}

function updateMapMarkers(){
  if(!map||!markerGroup)return;
  markerGroup.clearLayers();
  var filtered=getFilteredEvents();
  var added={};
  filtered.forEach(function(e){
    var vname=getEventVenue(e);
    if(!vname||added[vname])return;
    added[vname]=true;
    var coords=getVenueCoords(vname);
    if(!coords)return;
    var fd=fmt(e.start_date);
    var title=esc(e.title);
    var cat=catLabel(e.category);
    var date=fd?fd.display:"";
    var icon=L.divIcon({className:"",html:'<div style="width:32px;height:32px;background:var(--gold);border:2px solid var(--bg);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:12px;color:var(--bg);font-weight:600;box-shadow:0 2px 8px rgba(0,0,0,.5)">'+vname[0]+"</div>",iconSize:[32,32],iconAnchor:[16,16]});
    var marker=L.marker(coords,{icon:icon}).addTo(markerGroup);
    marker.bindPopup('<strong>'+title+'</strong><div class="popup-cat">'+cat+'</div><div class="popup-date">'+date+"</div>");
  });
  if(Object.keys(added).length>0){map.fitBounds(markerGroup.getBounds().pad(0.15));}
}

function getFilteredEvents(){
  var from=document.getElementById("date-from").value;
  var to=document.getElementById("date-to").value;
  var act=document.querySelector(".filt.on");
  var cat=act?act.dataset.cat:"";
  var q=document.getElementById("search").value.toLowerCase().trim();
  return EVENTS.filter(function(e){
    var sd=fmt(e.start_date),ed=fmt(e.end_date);
    if(!sd)return false;
    var es=sd.iso,ee=ed?ed.iso:es;
    if(ee<todayS)return false;if(from&&ee<from)return false;if(to&&es>to)return false;
    if(cat&&e.category!==cat)return false;
    if(q&&!e.title.toLowerCase().includes(q)&&!strip(e.description||"").toLowerCase().includes(q))return false;
    return true;
  }).sort(function(a,b){return(a.start_date||"").localeCompare(b.start_date||"");});
}

function filterByVenue(name){
  document.querySelectorAll(".filt.on").forEach(function(b){b.classList.remove("on");});
  document.querySelector(".filt[data-cat='']").classList.add("on");
  document.getElementById("search").value=name;
  document.querySelectorAll(".qfilt.on").forEach(function(b){b.classList.remove("on");});
  document.getElementById("events").scrollIntoView({behavior:"smooth"});
  render();
}

function openModal(idx){
  var e=EVENTS[idx];if(!e)return;var id=evId(e);
  window.history.pushState({modal:idx},"","#"+id);
  var fd=fmt(e.start_date),ed=fmt(e.end_date);
  var dateR=e.end_date&&e.end_date!==e.start_date?(fd?fd.display:"")+" -> "+(ed?ed.display:""):(fd?fd.display:"");
  var cc=catColor(e.category),lb=catLabel(e.category);
  var img=e.image_url&&!e.image_url.startsWith("data:")?e.image_url:"";
  var hs=e.showtimes&&Object.keys(e.showtimes).length>0;
  document.getElementById("modal-img").src=img;document.getElementById("modal-img").alt=esc(e.title);
  document.getElementById("modal-cat").className="modal-cat "+cc;document.getElementById("modal-cat").textContent=lb;
  document.getElementById("modal-venue").textContent=e.venue||getEventVenue(e)||"";
  document.getElementById("modal-title").textContent=e.title;
  var info="";var v=e.venue||getEventVenue(e)||"";
  if(dateR)info+='<div class="modal-info-item"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>'+esc(dateR)+'</div>';
  if(e.time)info+='<div class="modal-info-item"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>'+esc(e.time)+'</div>';
  info+='<div class="modal-info-item"><svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>'+lb+'</div>';
  if(v)info+='<div class="modal-info-item"><svg viewBox="0 0 24 24"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>'+esc(v)+'</div>';
  document.getElementById("modal-info").innerHTML=info;
  document.getElementById("modal-desc").textContent=strip(e.description||"").substring(0,500);
  document.getElementById("modal-address").textContent=[e.address,e.venue,e.commune].filter(Boolean).join(" - ")||"";
  var stEl=document.getElementById("modal-showtimes");
  if(hs){var h="<h4>Seances</h4><table>";for(var k in e.showtimes){var f=fmt(k);h+="<tr><td>"+(f?f.display:k)+"</td><td>"+e.showtimes[k].join(", ")+"</td></tr>";}h+="</table>";stEl.innerHTML=h;}else{stEl.innerHTML="";}
  document.getElementById("modal-source").href=e.source_url||"#";
  var sb=document.getElementById("modal-share");
  sb.onclick=function(){var u=window.location.origin+window.location.pathname+"#"+id;if(navigator.share){navigator.share({title:e.title,url:u}).catch(function(){});}else{navigator.clipboard.writeText(u);sb.innerHTML=t("copied");setTimeout(function(){sb.innerHTML='<span data-i18n="modal_share">'+t("modal_share")+'</span> <svg viewBox="0 0 24 24"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>';},2000);}};
  document.getElementById("modal").classList.add("open");document.body.style.overflow="hidden";
  var qs=document.querySelector(".modal");if(qs)qs.scrollTop=0;
}
function closeModal(){document.getElementById("modal").classList.remove("open");document.body.style.overflow="";window.history.pushState(null,"",window.location.pathname);}

function renderVenues(){
  var grid=document.getElementById("ven-grid");if(!grid)return;
  grid.innerHTML=VENUES.map(function(v){
    var name=esc(v.name);
    var img=v.image?'<img class="ven-card-img" src="'+v.image+'" alt="'+name+'" loading="lazy">':'<div class="ven-card-img-f">'+(v.key[0]||"")+'</div>';
    var cats=v.categories.map(function(c){return'<span class="ven-card-cat">'+(CAT_LABELS[c]||c)+'</span>';}).join("");
    return '<div class="ven-card" onclick="filterByVenue(\''+esc(v.key)+'\')">'+img+'<div class="ven-card-body"><div class="ven-card-name">'+name+'</div><div class="ven-card-meta"><span class="ven-card-type">'+esc(v.type)+'</span><span class="ven-card-loc">'+esc(v.location)+'</span></div><div class="ven-card-count">'+v.count+' '+(v.count>1?t("venue_count_other"):t("venue_count_one"))+'</div><div class="ven-card-cats">'+cats+'</div></div></div>';
  }).join("");
}

function render(){
  var filtered=getFilteredEvents();
  document.getElementById("ev-count").textContent=filtered.length;
  document.getElementById("ev-found-text")&&(document.getElementById("ev-found-text").textContent=t("events_found"));
  var grid=document.getElementById("ev-grid");
  if(!filtered.length){
    grid.innerHTML='<div class="mt"><div class="mt-i">--</div><div class="mt-t">'+t("empty_title")+'</div><div class="mt-d">'+t("empty_desc")+'</div><button class="mt-b" onclick="resetFilters()">'+t("empty_btn")+'</button></div>';
    return;
  }
  var evIndexMap=filtered.map(function(e){return EVENTS.indexOf(e);});
  grid.innerHTML=evIndexMap.map(function(oi,i){
    var e=EVENTS[oi];var fd=fmt(e.start_date);var desc=strip(e.description||"").substring(0,120);
    var isT=fd&&fd.iso===todayS,isTm=fd&&fd.iso===tomS;
    var tag=isT?t("today"):isTm?t("tomorrow"):"";
    var dl=fd?fd.dayNum:"",ml=fd?fd.month:"";
    var cc=catColor(e.category),lb=catLabel(e.category);
    var img=e.image_url&&!e.image_url.startsWith("data:")?'<img src="'+e.image_url+'" alt="'+esc(e.title)+'" loading="lazy" data-fb="'+esc(e.title[0]||"")+'">':'<div class="card-img-f">'+(e.title[0]||"")+'</div>';
    var evVenue=e.venue||getEventVenue(e)||"";var vHtml=evVenue?'<span class="card-venue">'+esc(evVenue)+'</span>':"";
    return '<div class="card" onclick="openModal('+oi+')" style="transition-delay:'+(i*0.06)+'s">'+
      '<div class="card-img">'+img+'<div class="card-img-o"></div><div class="card-date"><div class="dy">'+dl+'</div><div class="mo">'+ml+'</div></div>'+(tag?'<div class="card-tag">'+tag+'</div>':"")+'</div>'+
      '<div class="card-body"><div class="card-meta"><span class="card-cat '+cc+'">'+lb+'</span><span class="card-dot"></span><span class="card-venue">'+vHtml+'</span></div>'+
      '<h3 class="card-title">'+esc(e.title)+'</h3>'+(desc?'<p class="card-desc">'+desc+'</p>':"")+
      '<div class="card-ft"><button class="card-cta" onclick="event.stopPropagation();openModal('+oi+')">'+t("details")+' <svg viewBox="0 0 16 16" fill="none"><path d="M1 8h12M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></button></div></div></div>';
  }).join("");
  requestAnimationFrame(function(){document.querySelectorAll(".card").forEach(function(el,i){setTimeout(function(){el.classList.add("in");},i*60);});});
  if(map&&document.getElementById("map-container").classList.contains("show")){updateMapMarkers();}
}

function resetFilters(){
  document.querySelectorAll(".filt.on").forEach(function(b){b.classList.remove("on");});
  document.querySelector(".filt[data-cat='']").classList.add("on");
  document.getElementById("date-from").value="";document.getElementById("date-to").value="";
  document.getElementById("search").value="";document.querySelectorAll(".qfilt.on").forEach(function(b){b.classList.remove("on");});
  render();
}

document.addEventListener("error",function(e){if(e.target.tagName==="IMG"&&e.target.dataset.fb!==void 0){var fb=document.createElement("div");fb.className="card-img-f";fb.textContent=e.target.dataset.fb||"";e.target.parentNode.replaceChild(fb,e.target);}},true);


function toggleTheme(){var h=document.documentElement;var isLight=h.classList.contains('light');if(isLight){h.classList.remove('light');localStorage.setItem('chx-theme','dark')}else{h.classList.add('light');localStorage.setItem('chx-theme','light')}}
function applyTheme(){var t=localStorage.getItem('chx-theme');if(t==='light')document.documentElement.classList.add('light')}

function getCinemaFilms(){
  var films={};
  EVENTS.forEach(function(e,i){
    if(e.category!=='Cinema'&&e.category!=='cinema')return;
    if(!e.showtimes||!Object.keys(e.showtimes).length)return;
    var key=e.title.trim();
    if(!films[key]){
      films[key]={title:e.title,desc:e.description,image:e.image_url||'',venue:e.venue||'',lang:e.language||'Francais',source_url:e.source_url||'',showtimes:{},index:i};
    }
    for(var d in e.showtimes){
      if(!films[key].showtimes[d])films[key].showtimes[d]=[];
      e.showtimes[d].forEach(function(t){
        if(films[key].showtimes[d].indexOf(t)<0)films[key].showtimes[d].push(t);
      });
    }
  });
  return Object.keys(films).map(function(k){return films[k];});
}

function getCinemaDates(films){
  var dates={};
  films.forEach(function(f){
    for(var d in f.showtimes){
      if(!dates[d])dates[d]=0;
      dates[d]+=f.showtimes[d].length;
    }
  });
  return Object.keys(dates).sort();
}

function isToday(d){
  var now=new Date();return d===now.toISOString().split('T')[0];
}

function fmtDay(dStr){
  var d=new Date(dStr+'T12:00:00');
  var DAYS_SHORT=t('d0')?[t('d0'),t('d1'),t('d2'),t('d3'),t('d4'),t('d5'),t('d6')]:['Dim','Lun','Mar','Mer','Jeu','Ven','Sam'];
  var MONTHS_SHORT=t('m0')?[t('m0'),t('m1'),t('m2'),t('m3'),t('m4'),t('m5'),t('m6'),t('m7'),t('m8'),t('m9'),t('m10'),t('m11')]:['Jan','Fev','Mar','Avr','Mai','Juin','Juil','Aou','Sep','Oct','Nov','Dec'];
  return {dow:DAYS_SHORT[d.getDay()],day:d.getDate(),month:MONTHS_SHORT[d.getMonth()],iso:dStr};
}

function fmtTime(t){
  return t.substring(0,5);
}

function renderCinemaDays(films){
  var el=document.getElementById('cinema-days');
  if(!el)return;
  var dates=getCinemaDates(films);
  if(!dates.length){el.innerHTML='';return;}
  var sel=document.getElementById('cinema-list').dataset.date||dates[0];
  el.innerHTML=dates.map(function(d){
    var f=fmtDay(d);
    var cls='cinema-day'+(d===sel?' on':'')+(isToday(d)?' today':'');
    return '<button class="'+cls+'" data-date="'+d+'" onclick="selectCinemaDay(\''+d+'\')">'+f.day+'<span class="dow">'+f.dow+'</span></button>';
  }).join('');
  el.scrollLeft=0;
  // Scroll to selected
  var selBtn=el.querySelector('.on');
  if(selBtn)selBtn.scrollIntoView({behavior:'smooth',inline:'center',block:'nearest'});
}

function selectCinemaDay(d){
  document.getElementById('cinema-list').dataset.date=d;
  renderCinemaDays(getCinemaFilms());
  renderCinemaList(d);
}

function renderCinemaList(date){
  var el=document.getElementById('cinema-list');
  var empty=document.getElementById('cinema-empty');
  if(!el)return;
  var films=getCinemaFilms();
  if(!date){date=films.length?getCinemaDates(films)[0]||'':'';}
  el.dataset.date=date;
  
  var today=new Date();
  var todayStr=today.toISOString().split('T')[0];
  var nowH=today.getHours(),nowM=today.getMinutes();
  var nowTotal=nowH*60+nowM;
  
  var dayFilms=films.filter(function(f){return f.showtimes[date]&&f.showtimes[date].length;}).sort(function(a,b){var at=a.showtimes[date]?parseInt(a.showtimes[date][0]):'99:99';var bt=b.showtimes[date]?parseInt(b.showtimes[date][0]):'99:99';return at<bt?-1:at>bt?1:0;});
  
  if(!dayFilms.length){
    el.innerHTML='';empty.style.display='block';return;
  }
  empty.style.display='none';
  
  el.innerHTML=dayFilms.map(function(f){
    var img=f.image?'<img src="'+esc(f.image)+'" alt="'+esc(f.title)+'" loading="lazy">':'<div class="no-img">'+esc(f.title[0]||'')+'</div>';
    var isVO=(f.lang&&f.lang.toLowerCase().indexOf('vo')>=0);
    var langTag=isVO?'<span class="lang vo">VO</span>':'<span class="lang">FR</span>';
    var times=f.showtimes[date].map(function(t){
      var cleanT=t.substring(0,5);
      var parts=cleanT.split(':');
      var tMin=parseInt(parts[0])*60+parseInt(parts[1]);
      var isPast=tMin<nowTotal&&date===todayStr;
      var isNow=!isPast&&Math.abs(tMin-nowTotal)<=60&&date===todayStr;
      var cls='time-btn'+(isPast?' past':'')+(isNow?' now':'');
      return '<button class="'+cls+'" onclick="event.stopPropagation();">'+cleanT+'</button>';
    }).join('');
    
    return '<div class="cinema-row"><div class="cinema-row-poster">'+img+'</div><div class="cinema-row-info"><div class="cinema-row-title">'+esc(f.title)+'</div><div class="cinema-row-meta">'+langTag+'<span>'+esc(f.venue||'Le Vox')+'</span></div><div class="cinema-row-times">'+times+'</div></div></div>';
  }).join('');
}

function toggleCinema(show){
  var cinema=document.getElementById('cinema');
  var events=document.getElementById('events');
  var venues=document.getElementById('venues');
  var map=document.getElementById('map-container');
  
  if(show){
    cinema.style.display='block';
    if(events)events.style.display='none';
    if(venues)venues.style.display='none';
    if(map)map.style.display='none';
    document.getElementById('nav-cinema')&&(document.getElementById('nav-cinema').style.color='var(--gold)');
    // Close hamburger
    var nl=document.getElementById('nav-links');
    if(nl)nl.classList.remove('open');
    
    var films=getCinemaFilms();
    var dates=getCinemaDates(films);
    var targetDate=dates[0]||new Date().toISOString().split('T')[0];
    renderCinemaDays(films);
    renderCinemaList(targetDate);
    
    // Scroll to cinema
    setTimeout(function(){
      cinema.scrollIntoView({behavior:'smooth',block:'start'});
    },100);
  }else{
    cinema.style.display='none';
    if(events)events.style.display='block';
    if(venues)venues.style.display='';
    if(map)map.style.display='';
    document.getElementById('nav-cinema')&&(document.getElementById('nav-cinema').style.color='');
  }
}

function init(){
  setTimeout(function(){var pl=document.getElementById("preloader");if(pl)pl.classList.add("hidden");},800);
  window.addEventListener("scroll",function(){var nav=document.getElementById("nav");if(nav)nav.classList.toggle("scrolled",window.scrollY>60);var btt=document.getElementById("btt");if(btt)btt.classList.toggle("show",window.scrollY>600);});
  document.getElementById("hamburger").addEventListener("click",function(){document.getElementById("nav-links").classList.toggle("open");});
  document.getElementById("nav-cinema").addEventListener("click",function(e){e.preventDefault();toggleCinema(true);document.getElementById("nav-links").classList.remove("open");});
  document.querySelectorAll("[href='#events']").forEach(function(a){a.addEventListener("click",function(){if(document.getElementById("cinema").style.display!=='none')toggleCinema(false);document.getElementById("nav-links").classList.remove("open");});});
  document.querySelectorAll("[href='#venues']").forEach(function(a){a.addEventListener("click",function(){if(document.getElementById("cinema").style.display!=='none')toggleCinema(false);document.getElementById("nav-links").classList.remove("open");});});
  document.getElementById("btt").addEventListener("click",function(){window.scrollTo({top:0,behavior:"smooth"});});
  var st;document.getElementById("search").addEventListener("input",function(){clearTimeout(st);st=setTimeout(render,200);});
  document.querySelectorAll(".qfilt").forEach(function(btn){
    btn.addEventListener("click",function(){
      var q=btn.dataset.q;var d1=new Date(today),d2=new Date(today);
      document.querySelectorAll(".qfilt.on").forEach(function(b){b.classList.remove("on");});btn.classList.add("on");
      if(q==="week"){var day=today.getDay();var diff=today.getDate()-day+(day===0?-6:1);d1.setDate(diff);d2.setDate(diff+6);}
      else if(q==="weekend"){var day=today.getDay();var diff=today.getDate()+(day===0?0:6-day);d1.setDate(diff);d2.setDate(diff+1);}
      else if(q==="month"){d1.setDate(1);d2.setMonth(d2.getMonth()+1);d2.setDate(0);}
      document.getElementById("date-from").value=d1.toISOString().split("T")[0];document.getElementById("date-to").value=d2.toISOString().split("T")[0];render();
    });
  });
  document.getElementById("map-toggle").addEventListener("click",toggleMap);
  document.getElementById("theme-btn").addEventListener("click",function(){toggleTheme();renderVenues();render();var mc=document.getElementById("map-container");if(mc&&mc.classList.contains("show")&&map){map.remove();map=null;initMap();updateMapMarkers();}});
  document.getElementById("locale-sel").addEventListener("change",function(){LOCALE=this.value;localStorage.setItem(LOCALE_KEY,LOCALE);applyLocale();renderVenues();render();});
  document.getElementById("modal-close").addEventListener("click",closeModal);
  document.getElementById("modal").addEventListener("click",function(e){if(e.target===this)closeModal();});
  document.addEventListener("keydown",function(e){if(e.key==="Escape")closeModal();});
  window.addEventListener("popstate",function(e){if(e.state&&e.state.modal!==void 0){openModal(e.state.modal);}else if(document.getElementById("modal").classList.contains("open")){closeModal();}});
  var hash=window.location.hash.slice(1);if(hash){var idx=EVENTS.findIndex(function(e){return evId(e)===hash;});if(idx>=0){setTimeout(function(){openModal(idx);},1000);}}
  var obs=new IntersectionObserver(function(entries){entries.forEach(function(e){if(e.isIntersecting)e.target.classList.add("in");});},{threshold:0.1});
  document.querySelectorAll(".fade-in").forEach(function(el){obs.observe(el);});
  document.querySelectorAll(".filt:not(.date):not(.map-toggle)").forEach(function(btn){
    btn.addEventListener("click",function(){document.querySelectorAll(".filt.on").forEach(function(b){b.classList.remove("on");});btn.classList.add("on");render();});
  });
  ["date-from","date-to"].forEach(function(id){var el=document.getElementById(id);if(el)el.addEventListener("change",render);});
  var d1=new Date(today),d2=new Date(today);d2.setDate(d2.getDate()+30);
  document.getElementById("date-from").value=d1.toISOString().split("T")[0];document.getElementById("date-to").value=d2.toISOString().split("T")[0];
  applyTheme();renderVenues();render();applyLocale();
}
document.addEventListener("DOMContentLoaded",init);

</script>
</body>
</html>
