":"Mån","d2":"Tis","d3":"Ons","d4":"Tor","d5":"Fre","d6":"Lör","vCinema":"Bio","vconcert":"Bar / Konsert","vexhibition":"Utställning","vtheatre":"Teater","vsport":"Sport","vmarket":"Marknad","vfamily":"Familj","v_":"Ställe","nav_cinema":"Bio","cinema_no_films":"Inga visningar idag"},"hu":{"name":"Magyar","hero_label":"Chamonix-völgy","hero_sub":"Fedezze fel a völgy legjobb eseményeit, koncertjeit és éjszakai életét.","nav_events":"Események","nav_venues":"Helyszínek","nav_cinema":"Mozi","scroll":"Görgetés","sec_label":"Program","sec_title":"Összes esemény","search_placeholder":"Keresés...","q_week":"Ezen a héten","q_weekend":"Ezen a hétvégén","q_month":"Ebben a hónapban","filter_all":"Mind","filter_cinema":"Mozi","filter_concert":"Koncert","filter_exhibition":"Kiállítás","filter_family":"Család","filter_market":"Piaci","filter_other":"Egyéb","filter_sport":"Sport","filter_theatre":"Színház","date_from":"Ettől","date_to":"Eddig","map_btn":"Térkép","grid_btn":"Rács","events_found":"esemény található","today":"Ma","tomorrow":"Holnap","details":"Részletek","empty_title":"Nincs találat","empty_desc":"Próbálja bővíteni vagy módosítani a szűrőket.","empty_btn":"Szűrők törlése","venue_badge":"Kiemelt Helyszín","venue_section":"Összes helyszín","venue_count_one":"esemény","venue_count_other":"esemény","modal_source":"Forrás megtekintése","modal_share":"Megosztás","copied":"Másolva!","ftr_text":"Események összegyűjtve a chamonix.net és AlloCiné forrásból","m0":"Jan","m1":"Feb","m2":"Márc","m3":"Ápr","m4":"Máj","m5":"Jún","m6":"Júl","m7":"Aug","m8":"Szept","m9":"Okt","m10":"Nov","m11":"Dec","d0":"Vas","d1":"Hét","d2":"Kedd","d3":"Sze","d4":"Csü","d5":"Pén","d6":"Szo","vCinema":"Mozi","vconcert":"Bár / Koncert","vexhibition":"Kiállítás","vtheatre":"Színház","vsport":"Sport","vmarket":"Piaci","vfamily":"Családi","v_":"Helyszín","cinema_no_films":"Ma nincs vetítés"}};
function t(k){var l=I18N[LOCALE]||I18N['fr'];return l[k]||k;}
function cycleLocale(l){if(l){LOCALE=l}else{var a=['en','fr','es','hu','sv'];var i=a.indexOf(LOCALE);LOCALE=a[(i+1)%a.length]}localStorage.setItem(LOCALE_KEY,LOCALE);if(document.getElementById('locale-sel'))document.getElementById('locale-sel').value=LOCALE;applyLocale();renderVenues();render()}
function applyLocale(){
document.querySelectorAll('[data-i18n]').forEach(function(el){var k=el.getAttribute('data-i18n');if(k==='search_placeholder'||k==='date_from'||k==='date_to')el.placeholder=t(k);else el.textContent=t(k);});
var btn=document.getElementById('locale-btn');if(btn)btn.textContent=I18N[LOCALE].name;
document.documentElement.lang=LOCALE;
}
</script>

<script>

var EVENTS = [{"id": "exposition-peintures-montagnes-2026-04-24", "title": "Exposition peintures Montagnes", "description": "La technique de la gravure sur place permet de saisir le mouvement du paysage, et par le trait spontané, sa force.\nJe tente d’apprendre le relief, de dessiner mille fois la même montagne pour m’abstraire et rêver.\nJ’imprime l’estampe sous presse.Les techniques utilisées sont : gravure sur bois et linoléum, gravure sur acier : aquatinte, sucre, eau-forte, et pointe sèche. Huile, pastel.Elève en sculpture de Jacques Canonici et de Marie-Claire Graillot en gravure, je travaille comme marin professionnel ; j’embarque sur le pont à la pêche ou en machine au commerce au long cours.\\nEntrée libre.\\nDu 24/04 au 20/06/2026 le mardi, mercredi, jeudi, vendredi et samedi de 9h à 12h et de 14h à 17h.\\nExposition peintures MontagnesMaison de Village d'Argentière101 rte du village74400 ArgentièreArrêt de bus le plus proche : Argentière La FizArrêt de train le plus proche : Gare ArgentièreParking à proximité : La FizEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-04-24", "end_date": "2026-06-20", "category": "exhibition", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-chamonix-et-argentiere/exposition-peintures-montagnes", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7794961/40935840.jpg?itok=uTkgpr9h", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498073+00:00", "updated_at": "2026-05-27T12:31:09.498074+00:00", "address": "Maison de Village d'Argentière101 rte du village74400 Argentière"}, {"id": "exposition-charlie-adam-2026-05-04", "title": "Exposition - Charlie Adam", "description": "C’est en place !\nLa nouvelle exposition de Charlie Adam a été installée aujourd’hui dans le hall de la mairie des Houches.\nUn nom bien connu dans la vallée, que la commune est fière d’accueillir pour cette exposition à (re)découvrir.\\nAccès libre.\\nDu 04/05 au 30/06/2026 du lundi au vendredi de 8h30 à 12h et de 14h à 17h30. Le samedi de 9h à 12h.\\nExposition - Charlie AdamMairie Les Houches1 place de la Mairie74310 Les HouchesArrêt de bus le plus proche: Les Houches - MairieArrêt de train le plus proche: Gare des HouchesParking gratuit à proximitéEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-05-04", "end_date": "2026-06-30", "category": "exhibition", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-les-houches-servoz/exposition-charlie-adam", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7814397/41467816.jpg?itok=GVF1T1T0", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498085+00:00", "updated_at": "2026-05-27T12:31:09.498087+00:00", "time": "8h30", "address": "Mairie Les Houches1 place de la Mairie74310 Les Houches"}, {"id": "spectacle-très-jeune-public-émouvoir-2026-05-27", "title": "Spectacle très jeune public - (é)Mouvoir", "description": "Le point de départ de cette exploration est l’attention particulière du jeune enfant lorsqu’il regarde les feuilles des arbres bouger et sa fascination pour ce qui est en mouvement.(É)mouvoir explorera la notion d’impermanence :comme le monde végétal, le tout-petit est en constante évolution. Tout ce qui nous entoure se transforme continuellement, même si nous ne le percevons pas, et c’est ce que nous avons envie de montrer à travers cette création.Nous avons envie de concevoir un parcours où l’enfant puisse expérimenter sans être dirigé : sentir la pluie sur la peau, caresser la mousse, traverser de grandes herbes mouvantes, s’étendre sur un tapis de feuillesNous proposerons une scénographie où le tout petit pourra se déplacer d’un coin à l’autre de l’espace pour explorer selon ses besoins, et nous espérons que l’adulte, qui fera aussi cette traversée, sera au côté de l’enfant dans une expérience partagée non pas comme guide mais comme compagnon de route !Compagnie entre eux deux rivesescalator_warning_blackAge minimum0.5 ans\\nTarif unique : 5 € (par personne).\\nMercredi 27 mai 2026 Horaires de représentation à partir de 9h30 et à partir de 11h15.\\nSpectacle très jeune public - (é)MouvoirEspace Michel Croz  -EMC274400 Chamonix-Mont-BlancEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-05-27", "category": "theatre", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-chamonix-et-argentiere/spectacle-tres-jeune-public-e-mouvoir", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7642399/37152921.jpg?itok=aofUgQ9L", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498042+00:00", "updated_at": "2026-05-27T12:31:09.498044+00:00", "time": "9h30", "address": "Espace Michel Croz  -EMC274400 Chamonix-Mont-Blanc"}, {"id": "don-de-sang-2026-05-28", "title": "Don de sang", "description": "Pour sauver des vies et aider des malades, une collecte de sang est organisée par l’Établissement Français du Sang en lien avec l'association locale des donneurs de sang bénévoles.En toute convivialité, vous rencontrerez un médecin avant le prélèvement, et une collation vous sera offerte par l'association locale des donneurs de sang, à l'issue de votre don. Dans la journée précédant le don, bien s'hydrater et s'alimenter normalement. Ouvert aux personnes âgées de 18 à 70 ans. Parking offert.\\nAccès libre.\\nJeudi 28 mai 2026 de 12h à 19h.\\nDon de sangPresbytère Saint-Michel82 rue de la Mollard74400 Chamonix-Mont-BlancEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-05-28", "category": "other", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-chamonix-et-argentiere/don-de-sang-10", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7644105/37180078.jpg?itok=cWdyVXAs", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498052+00:00", "updated_at": "2026-05-27T12:31:09.498054+00:00", "address": "Presbytère Saint-Michel82 rue de la Mollard74400 Chamonix-Mont-Blanc"}, {"id": "changer-de-face-2026-05-29", "title": "Changer de Face", "description": "Une soirée dédiée à l’impact des changements climatiques : comment gardiens et gardiennes de la montagne appréhendent les conséquences sur leurs environnements, leurs métiers et leurs pratiques.\\nAccès libre.\\nVendredi 29 mai 2026 de 20h à 22h.\\nChanger de FaceEspace Michel Croz  -EMC274400 Chamonix-Mont-BlancEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-05-29", "category": "other", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-chamonix-et-argentiere/changer-de-face", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7828078/41394704.jpg?itok=GuEXnOqB", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498060+00:00", "updated_at": "2026-05-27T12:31:09.498061+00:00", "address": "Espace Michel Croz  -EMC274400 Chamonix-Mont-Blanc"}, {"id": "bal-folk-2026-05-30", "title": "Bal folk", "description": "Pour clôturer le stage de musiques traditionnelles organisé par l'EMDI , les élèves et les professeurs de l'ensemble BALABULLE vous proposent de venir écouter et danser sur leurs musiques\\nSamedi 30 mai 2026 de 19h à 20h30.\\nBal folkEspace Animation27 pl de la Mairie74310 Les HouchesArrêt de bus le plus proche: Les Houches MairieArrêt de train le plus proche: Gare des HouchesParking à proximité: Le Freney ou MairieEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-05-30", "category": "other", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-les-houches-servoz/bal-folk", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7810115/41096013.jpg?itok=I1GZ3v9_", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498079+00:00", "updated_at": "2026-05-27T12:31:09.498080+00:00", "time": "20h30", "address": "Espace Animation27 pl de la Mairie74310 Les Houches"}, {"id": "fête-des-associations-spéciale-mamans-2026-05-31", "title": "Fête des Associations - Spéciale Mamans", "description": "La commune des Houches fête ses associations et les mamans ! Rendez-vous au lac des Chavants, pour une découverte d’activités associatives, un marché aux fleurs, un vide-greniers organisé par l’APE, des concerts et pleins de belles choses !Au programme :Structure gonflable - Stands associatifs - Découvertes d’activités associatives – Stands Artisanaux -Marché aux fleurs - Vide Grenier - Buvette sur place (snack & boissons)Pour le vide grenier de l'APE, inscription par mail à apeleshouches@gmail.com | 15€ par emplacement10h : Démos de danse avec l'association Espace Evasion11h30 : Concert de l'harmonie Municipale12h30 : Apéritif offert par la Mairie pour les Mamans13h30 : Initiation Capoeira15h : Concert d'EdgarPleins de surprises vous sont réservés durant cette belle célébration, venez nombreux !A noter qu’en cas de mauvais temps, l’évènement n’aura pas lieu mais un repli surprise sera prévu à l'Espace Animation des Houches.\\nAccès libre. Initiations offertes par les associations des HouchesApéritif offert par la Mairie des HouchesSéance de cinéma offerte aux mamans des Houches (tarifs habituels pour les autres).\\nDimanche 31 mai 2026 de 10h à 18h.\\nFête des Associations - Spéciale MamansLac des Chavants148 allée des dilligences74310 Les HouchesArrêt de bus le plus proche: Le PrarionArrêt de train le plus proche: Viaduc Sainte MarieParking sur placeEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-05-31", "category": "other", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-les-houches-servoz/fete-des-associations-speciale-mamans", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7820276/41268391.jpg?itok=7FPkdoi0", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498103+00:00", "updated_at": "2026-05-27T12:31:09.498104+00:00", "time": "11h30", "address": "Lac des Chavants148 allée des dilligences74310 Les Houches"}, {"id": "cinéma-enfants-peppa-au-cinéma-la-famille-sagrandit-2026-06-03", "title": "Cinéma enfants « Peppa au cinéma : La famille s’agrandit »", "description": "« Peppa au cinéma : La famille s’agrandit » de Mark BAKER, Neville ASTLEY - GB 2026 - Durée 0h49 - Courts-métrages d'animationRetrouvez Peppa et toute sa joyeuse famille au cinéma pour une aventure « grointastique » à vivre sur grand écran ! L’an dernier, la famille accueillait la petite Evie et compte maintenant cinq membres, prêts à multiplier les fous rires et les instants complices.  Soyez parmi les premiers à découvrir des épisodes totalement inédits, accompagnés d'un best of de vos épisodes préférés. Au programme : Papa Pig prépare son tout premier marathon, George explore de nouvelles façons d'écouter et de comprendre le monde, et bien d'autres aventures ! Entre sauts dans les flaques de boue, éclats de rire et moments riches en émotions, cet événement exceptionnel rassemble de nouvelles aventures et des épisodes déjà cultes ! Un rendez-vous chaleureux et amusant, pensé pour émerveiller petits et grands… sur grand écran !escalator_warning_blackAge minimum3 ans\\nTarif réduit : 3,50 €.Adhésion annuelle facultative : 10 € (Donne droit au tarif réduit toute l'année)Modes de paiement : espèces ou chèques.\\nMercredi 3 juin 2026 à partir de 17h30.\\nCinéma enfants « Peppa au cinéma : La famille s’agrandit »Espace Animation27 pl de la Mairie74310 Les HouchesArrêt de bus le plus proche: Les Houches MairieArrêt de train le plus proche: Gare des HouchesParking à proximité: Le Freney ou MairieEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-06-03", "category": "family", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-les-houches-servoz/cinema-enfants-peppa-au-cinema-la-famille-s-agrandit", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7806746/41047286.jpg?itok=ZWhKxF0I", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498123+00:00", "updated_at": "2026-05-27T12:31:09.498125+00:00", "time": "0h49", "address": "Espace Animation27 pl de la Mairie74310 Les Houches"}, {"id": "cinéma-une-fille-en-or-2026-06-03", "title": "Cinéma « Une fille en or »", "description": "« Une fille en or » de Jean-Luc Gaget avec Pauline Clément, Arthur Dupont, Émilie Caen - France 2026 - Durée 1h26Un jour, Clémence prend conscience que personne ne l'a jamais admirée. Bercée par les illusions d'une enfance chaotique, elle croise un certain Paul, petit patron autoritaire que rien ni personne n'impressionne. Elle se dit alors qu'il est temps pour elle de se poser la seule question qui vaille : « Et si je valais plus que je ne le crois ? »\\nTarif réduit : 4,50 €, Adulte : 5,50 €, Enfant (0-24 ans) : 3,50 €.Adhésion annuelle facultative : 10 € (Donne droit au tarif réduit toute l'année)Modes de paiement : espèces ou chèques.\\nMercredi 3 juin 2026 à partir de 20h30.\\nCinéma « Une fille en or »Espace Animation27 pl de la Mairie74310 Les HouchesArrêt de bus le plus proche: Les Houches MairieArrêt de train le plus proche: Gare des HouchesParking à proximité: Le Freney ou MairieEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-06-03", "category": "other", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-les-houches-servoz/cinema-une-fille-en-or", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7806742/41047274.jpg?itok=Y1VCa0tK", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498111+00:00", "updated_at": "2026-05-27T12:31:09.498113+00:00", "time": "1h26", "address": "Espace Animation27 pl de la Mairie74310 Les Houches"}, {"id": "cloture-de-la-saison-2026-06-06", "title": "CLOTURE DE LA SAISON", "description": "Les Arts dans la rue - deux spectacles18h Trajectoires - Compagnie Pyramid- Spectacle danse Hip-Hop. Entre danse hip-hop, burlesque et théâtre d'objets, Trajectoires met en scène cinq personnages dans des tableaux saisissants de poésie et d'énergie.Une réflexion autour de la quête de soi, de la liberté, des rêves et défis de l'existence.19h30 : Salto- Cie El Nucleo- Spectacle de cirque- Salto, expérimentation acrobatique, étude des inégalités du quotidien et ode à l’émancipation.11 interprètes, 11 parcours, 1 chrono…Gratuit.Si mauvaise météo rapatriement à la salle Emc2 :  places limitées.\\nSamedi 6 juin 2026 à partir de 18h.\\nCLOTURE DE LA SAISONPlace du Mont-Blancplace du Mont-Blanc74400 Chamonix-Mont-BlancCOPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-06-06", "category": "other", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-chamonix-et-argentiere/cloture-de-la-saison", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7832709/41456551.jpg?itok=uZhMxlBz", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498142+00:00", "updated_at": "2026-05-27T12:31:09.498143+00:00", "time": "19h30", "address": "Place du Mont-Blancplace du Mont-Blanc74400 Chamonix-Mont-Blanc"}, {"id": "concert-du-choeur-du-prieuré-2026-06-06", "title": "Concert du Choeur du Prieuré", "description": "Concert de solidarité au profit de la restauration de l’égliseprogramme : Œuvres de MENDELSSOHN, DE HAAN et MOZARTDirection : Jean-Marie COUTTET. Accompagnement : Marie-Noëlle SOGHOMONIAN.\\nParticipation libre.\\nSamedi 6 juin 2026 à partir de 20h30.\\nConcert du Choeur du PrieuréEglise Saint MichelPlace de l'église74400 Chamonix-Mont-BlancArrêt de bus le plus proche: Chamonix CentreArrêt de train le plus proche: Gare de Chamonix-Mont-BlancParking à proximité: Parking Saint MichelEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-06-06", "category": "concert", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-chamonix-et-argentiere/concert-du-choeur-du-prieure", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/6727346/41425962.jpg?itok=tYmQLNiO", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498130+00:00", "updated_at": "2026-05-27T12:31:09.498132+00:00", "time": "20h30", "address": "Eglise Saint MichelPlace de l'église74400 Chamonix-Mont-Blanc"}, {"id": "spectacle-de-danse-2026-06-06", "title": "Spectacle de danse", "description": "Spectacle de fin d'année de l'association Espace Evasion et LCRdanceschool\nStreet dance,  StreetJazz, Commercial et Urban\n\nBuvette sur place\\nGratuit. Buvette sur place.\\nSamedi 6 juin 2026 à partir de 20h.\\nSpectacle de danseCentre sportif Richard Bozon214 av. de la Plage74400 Chamonix-Mont-BlancNavette gratuite le Mulet.COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-06-06", "category": "theatre", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-chamonix-et-argentiere/spectacle-de-danse-1", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7831098/41432926.jpg?itok=NjzvDXwy", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498136+00:00", "updated_at": "2026-05-27T12:31:09.498137+00:00", "address": "Centre sportif Richard Bozon214 av. de la Plage74400 Chamonix-Mont-Blanc"}, {"id": "cinéma-juste-une-illusion-2026-06-07", "title": "Cinéma « Juste une illusion »", "description": "« Juste une illusion » de Olivier Nakache, Eric Toledano avec Louis Garrel, Camille Cottin, Pierre Lottin - France 2026 - Durée 1h56Nous sommes en 1985, Vincent, bientôt 13 ans, vit en banlieue parisienne dans une famille de la classe moyenne, entre un grand frère distant et des parents en conflit permanent. Alors qu’il n’est « déjà plus » un enfant et qu’il n’est « pas encore » un adulte nous allons partager ses questions et ses doutes sur l’identité, l’amitié, la famille, la religion, le désir et les premiers élans amoureux.  Une comédie sur cette période de l’enfance où l’espoir de changer le monde n’était pas “Juste une illusion…”\\nTarif réduit : 4,50 €, Adulte : 5,50 €, Enfant (0-24 ans) : 3,50 €.Adhésion annuelle facultative : 10 € (Donne droit au tarif réduit toute l'année)Modes de paiement : espèces ou chèques.\\nDimanche 7 juin 2026 à partir de 17h30.\\nCinéma « Juste une illusion »Espace Animation27 pl de la Mairie74310 Les HouchesArrêt de bus le plus proche: Les Houches MairieArrêt de train le plus proche: Gare des HouchesParking à proximité: Le Freney ou MairieEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-06-07", "category": "other", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-les-houches-servoz/cinema-juste-une-illusion", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7806739/41047251.jpg?itok=6Hx1pDor", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498149+00:00", "updated_at": "2026-05-27T12:31:09.498150+00:00", "time": "1h56", "address": "Espace Animation27 pl de la Mairie74310 Les Houches"}, {"id": "journée-nationale-de-la-pêche-2026-06-07", "title": "Journée Nationale de la Pêche", "description": "Fête de la Pêche 2026 - Lac des GaillandsLa journée annuelle de promotion de la pêche en eau douce, plus connue sous l’appellation de « Fête de la Pêche », est le rendez-vous pour célébrer la pêche de loisir, qui est une des rares activités intergénérationnelles de pleine nature, qui compte plus de 1,5 million d’adhérents en France (2ème fédération en nombre après le foot).Au programme, suivant les associations et possibilités : découverte de différentes techniques de pêche (leurre, toc, mouche…), montage de lignes, rencontre avec les poissons d’eau douce, baptême de float-tube, jeux de lancer sur cible, simulateur de pêche…Particularité de ce jour: c’est le seul de l’année où la carte de pêche n’est pas nécessaire, pour tenir une canne et prendre un poisson, à condition d’être encadré dans une de ces animations.La Fête de la Pêche est aussi l’occasion d’informer le public sur la protection des écosystèmes aquatiques et l’action des AAPPMA et des pêcheurs dans ce domaine.Dimanche 7 juin 2026Destiné à tous, adultes, familles, enfants accompagnés (pêche à partir de 7 ans)Pas de réservation nécessaireHoraire: 9 h – 16 h.Buvette et petite restauration\\nDimanche 7 juin 2026 de 9h à 16h.\\nJournée Nationale de la PêcheLac des Gaillandsroute des Gaillands74400 Chamonix-Mont-BlancEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-06-07", "category": "other", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-chamonix-et-argentiere/journee-nationale-de-la-peche", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7834183/41472098.jpg?itok=n7VJMh4X", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498161+00:00", "updated_at": "2026-05-27T12:31:09.498162+00:00", "address": "Lac des Gaillandsroute des Gaillands74400 Chamonix-Mont-Blanc"}, {"id": "vide-grenier-2026-06-07", "title": "Vide grenier", "description": "\"Et si on bougeait\" organise son vide grenier le dimanche 7 juin 2026. \nRéservé aux particuliers / Tarif :  15 € les 3x2 mètres\nBuvette, petite restauration et animations.\nRenseignements : www.etsionbougeait.com / sionbougeait@gmail.com\"Et si on bougeait\" organise son vide grenier le dimanche 7 juin 2026 (reporté le 14 juin 2026 si mauvais temps)Réservé aux particuliers / Tarif :  15 € les 3x2 mètresBuvette et petite restauration (hot-dog, crêpes, gâteaux)Animations : 10 :00 : Stretch Flow / 11 :00 : Zumba (participation au chapeau)Venez nombreux... Réservez dès à présent votre emplacement.Renseignements et réservations : www.etsionbougeait.comMail : sionbougeait@gmail.com\\nDimanche 7 juin 2026 de 9h à 17h.\\nVide grenierPré de l'Eglise74310 ServozEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-06-07", "category": "other", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/agenda/evenements-et-manifestations/vide-grenier-1", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7830766/41430377.jpg?itok=gZIClt70", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498155+00:00", "updated_at": "2026-05-27T12:31:09.498156+00:00", "address": "Pré de l'Eglise74310 Servoz"}, {"id": "la-marche-du-temps-profond-2026-06-08", "title": "La marche du temps profond", "description": "Connaissez-vous la « marche du temps profond » ? Nous parcourons physiquement les 4,6 milliards d’années d’histoire de la planète. Chaque arrêt est l’occasion d’un éclairage scientifique, et  d’une prise de recul « métaphysique » sur l'aventure du vivant.Marche-conférence autour de l’histoire du vivantConnaissez-vous le concept de « marche du temps profond » ? Nous parcourons physiquement les 4,6 milliards d’années d’histoire de notre planète. Depuis la formation de la Terre à notre point de départ, chaque pas nous rapproche d’un million d’années du temps présent.Tout au long de cette marche de 2,3 km, nous faisons des arrêts pour comprendre les grandes étapes de l’évolution de la vie sur Terre. Chaque arrêt est l’occasion d’un éclairage scientifique, mais aussi d’une prise de recul « métaphysique » sur cette grande aventure du vivant. Plus nous nous rapprochons du temps présent, plus le Mont-Blanc émerge et plus nous faisons référence à notre territoire.Une marche animée par Irène Alvarez, accompagnatrice en montagne, engagée pour une écologie profonde, fondatrice d’Immersion Montagne et  ancienne co-directrice du CREA Mont-Blanc.Rendez-vous devant les Tennis de Chamonix, lundi 8 juin à 18h.\\nGratuit. Gratuit sur réservation sur le Site de la Petite université. Réservé à nos adhérents (adhésion annuelle 20 euros).\\nLundi 8 juin 2026 de 18h à 20h.Lundi 8 juin De 18h à 20h.\\nLa marche du temps profondTennis de Chamonix214  av. de la Plage74400 Chamonix-Mont-BlancArrêt de bus le plus proche : Vallot ou Les MouillesArrêt du Mulet : Les MouillesArrêt de train le plus proche : Gare Chamonix CentreParking à proximité : Parking des TennisEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-06-08", "category": "market", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-chamonix-et-argentiere/la-marche-du-temps-profond", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7776974/40366104.jpg?itok=_AQk3TtQ", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498167+00:00", "updated_at": "2026-05-27T12:31:09.498168+00:00", "address": "Tennis de Chamonix214  av. de la Plage74400 Chamonix-Mont-Blanc"}, {"id": "science-sandwich-trail-en-montagne-quel-impact-sur-la-faune-sauvage-2026-06-09", "title": "Science Sandwich - Trail en montagne : quel impact sur la faune sauvage ?", "description": "Pour sa prochaine conférence, le CREA Mont-Blanc reçoit deux étudiantes en master, ayant étudié les impacts de l'Échappée Belle sur la faune sauvage (notamment bouquetins), et la perception qu'on les participant·es de leur pratique.Chaque été, des centaines de coureurs et de coureuses s'élancent sur les crêtes de Belledonne pour participer à l'Échappée Belle, l'un des grands événements de trail de la région. Mais que se passe-t-il côté faune pendant ce temps ? C'est la question qu'ont choisi d'explorer deux étudiantes en master, Marie Bonis Charancle et Diane Body, en croisant deux regards : celui de l'écologie et celui des sciences sociales.Lors de la prochaine conférence du CREA Mont-Blanc, elles exposeront les résultats de leur travaux, visant à  confronter les réponses comportementales des bouquetins observées sur le terrain à la perception qu'ont les pratiquant·es de leur propre impact au sein des écosystèmes de montagne.mardi 09 juin, de 12h30 à 13h30Observatoire du Mont-Blanc, 67 lacets du Belvédère, ChamonixPlus d’infos et inscriptions via hello asso : https://www.helloasso.com/associations/crea-mont-blanc/evenements/science-sandwich-trail-en-montagne-quel-impact-sur-la-faune-sauvage?_gl=1%2a15dti85%2a_gcl_au%2aMTcxNjEyODIyMy4xNzc3OTE0ODE2LjkzNzIyODUyMi4xNzc5Nzg5NzkxLjE3Nzk3ODk4NDE.\\nMardi 9 juin 2026 de 12h30 à 13h30.\\nScience Sandwich - Trail en montagne : quel impact sur la faune sauvage ?Observatoire du Mont-Blanc67, lacets du Belvédère74400 Chamonix-Mont-BlancCOPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-06-09", "category": "other", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-chamonix-et-argentiere/science-sandwich-trail-en-montagne-quel-impact-sur-la-faune-sauvage", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/7841180/41582876.jpg?itok=xXlfdodB", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498176+00:00", "updated_at": "2026-05-27T12:31:09.498177+00:00", "time": "12h30", "address": "Observatoire du Mont-Blanc67, lacets du Belvédère74400 Chamonix-Mont-Blanc"}, {"id": "chamonix-film-festival-2026-06-10", "title": "Chamonix Film Festival", "description": "La 5e édition du Chamonix film festival s’annonce comme un moment fort de l’année montagne à Chamonix. Avec une sélection exceptionnelle de 18 films, dont 14 inédits en France", "start_date": "2026-06-10", "end_date": "2026-06-14", "category": "exhibition", "commune": "Chamonix", "source_id": "chamonix_net", "source_url": "https://www.chamonix.net/english/events/chamonix-film-festival", "image_url": "https://www.chamonix.net/sites/default/files/styles/normal_size/public/events/chamonix-film-festival-2026.jpg?itok=p99mMkiy", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:05.118294+00:00", "updated_at": "2026-05-27T12:31:05.118295+00:00"}, {"id": "marathon-du-mont-blanc-2026-06-25", "title": "Marathon du Mont-Blanc", "description": "The MONT-BLANC MARATHON will take place from 27 to 30 JUNE 2024. Registrations for the 10km du Mont-Blanc, KM Vertical, Young Race Marathon and Mini Cross.", "start_date": "2026-06-25", "end_date": "2026-06-28", "category": "sport", "commune": "Chamonix", "source_id": "chamonix_net", "source_url": "https://www.chamonix.net/english/events/marathon-du-mont-blanc", "image_url": "https://www.chamonix.net/sites/default/files/styles/normal_size/public/events/maarathon-du-mont-blanc.jpg?itok=seWyt_5g", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:05.118284+00:00", "updated_at": "2026-05-27T12:31:05.118286+00:00"}, {"id": "marché-paysan-2026-11-01", "title": "Marché paysan", "description": "Venez découvrir tous nos produits locaux, directement du producteur au consommateur... Un vrai régal !!!L'occasion de rendre visite aux animaux de la ferme, découvrir et comprendre toute ma démarche du blé à la farine jusqu'au pain en voyant le moulin à meules de pierre en action mais également profiter de tous les produits fermiers proposés: fromages de chèvres, de vache d'Herens, reblochons et tommes fermières, charcuterie et viande de cochons fermiers nourris au petit lait et son, confitures et enfin bien sure le Pain de Chibon\\nDu 01/11/2025 au 01/11/2026 le mercredi de 15h à 18h30.\\nMarché paysanLa ferme du Pain de Chibon427 route du pont74310 Les HouchesEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2026-11-01", "end_date": "2026-11-01", "category": "market", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/agenda/evenements-et-manifestations/marche-paysan", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/189875/21711221.jpg?itok=tgrWFd5r", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498007+00:00", "updated_at": "2026-05-27T12:31:09.498024+00:00", "time": "18h30", "address": "La ferme du Pain de Chibon427 route du pont74310 Les Houches"}, {"id": "chamonix-market-day-every-saturday-2026-12-01", "title": "Chamonix Market Day (Every Saturday)", "description": "Every Saturday morning, from 8am to 1pm. Find all sorts of treats from local and regional producers, fresh fruits, seasonal vegetables, cheeses and charcuterie.", "start_date": "2026-12-01", "category": "market", "commune": "Chamonix", "source_id": "chamonix_net", "source_url": "https://www.chamonix.net/english/events/chamonix-market-day", "image_url": "https://www.chamonix.net/sites/default/files/styles/normal_size/public/events/marche_chamonix3.jpg?itok=OAU1mlHj", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:05.118258+00:00", "updated_at": "2026-05-27T12:31:05.118271+00:00"}, {"id": "exposition-trésor-minéral-la-collection-raymond-thibault-2027-09-22", "title": "Exposition : Trésor minéral : la collection Raymond Thibault", "description": "Découvrez une centaine de spécimens parmi les plus beaux cristaux collectés par Raymond Thibault, passionné de minéralogie et de gemmologie, pendant 50 ans. Rhodochrosite, Wulfénite, Azurite... Il y en a pour tous les goûts et toutes les couleurs !Passionné de minéralogie et de gemmologie, Raymond Thibault (1929-2014) a parcouru le monde afin d'enrichir sa collection de pièces remarquables.Notre nouvelle exposition temporaire vous invite à découvrir une centaine de spécimens parmi les plus beaux cristaux collectés par Raymond Thibault sur une période d’environ 50 ans.Rhodochrosite, Wulfénite, Azurite... Il y en a pour tous les goûts et toutes les couleurs !Exposition présentée jusqu'en décembre 2027.\\nTarifs non communiqués.Gratuit pour les moins de 18 ans.Droit d'entrée au musée.\\nDu 22/09/2024 au 03/11/2027, tous les mardis, mercredis, jeudis, vendredis, samedis et dimanches sauf les 1er janvier et 25 décembre.Selon horaires d'ouverture du musée des Cristaux.Fermé les 25 décembre, 1er janvier, 1er mai.\\nExposition : Trésor minéral : la collection Raymond ThibaultMusée des Cristaux - Espace Tairraz615 allée du Recteur Payot74400 Chamonix-Mont-BlancArrêt de bus le plus proche : Chamonix CentreArrêt Mulet : CasinoArrêt de train le plus proche : Gare Chamonix centreParking à proximité : Saint MichelEuropean Environment Agency (EEA) | COPERNICUS by the European Union and ESA |© OpenMapTiles© OpenStreetMap contributors© Loopi", "start_date": "2027-09-22", "end_date": "2027-11-03", "category": "exhibition", "commune": "Chamonix", "source_id": "chamonix_com", "source_url": "https://www.chamonix.com/animations-et-evenements-chamonix-et-argentiere/exposition-tresor-mineral-la-collection-raymond-thibault", "image_url": "https://www.chamonix.com/sites/default/files/styles/ogimage/public/sit/images/5979331/20447255.jpg?itok=x3IOHKH9", "status": "published", "confidence": 1.0, "created_at": "2026-05-27T12:31:09.498095+00:00", "updated_at": "2026-05-27T12:31:09.498096+00:00", "address": "Musée des Cristaux - Espace Tairraz615 allée du Recteur Payot74400 Chamonix-Mont-Blanc"}, {"title": "Star Wars: The Mandalorian and Grogu", "description": "Film screening at Le Vox", "event_type": "cinema", "category": "Cinema", "source_id": "allocine_vox", "source_url": "https://www.allocine.fr/seance/salle_gen_csalle=P1406.html", "image_url": "https://fr.web.img6.acsta.net/c_160_213/img/6e/84/6e847b845d10b7194d43f604b3ef1f20.jpg", "venue": "Le Vox", "address": "22, cours Bartavel, 74400 Chamonix-Mont-Blanc", "commune": "Chamonix", "start_date": "2026-05-27", "end_date": "2026-06-02", "showtimes": {"2026-05-27": ["15:30", "20:15"], "2026-05-29": ["20:15"], "2026-05-30": ["15:30", "13:45", "20:15", "18:45"], "2026-05-31": ["10:00", "18:00"], "2026-06-01": ["18:00"],