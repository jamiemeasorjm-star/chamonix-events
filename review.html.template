<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Review Queue — Chamonix Events</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#0b0a08;--surface:#141210;--card:#1a1815;--border:rgba(255,255,255,0.06);--border-a:rgba(200,164,92,0.25);--text:#ede8e0;--text2:#9a948c;--text3:#6b6660;--gold:#c8a45c;--gold-h:#d4b46a;--gold-d:rgba(200,164,92,0.15);--ok:#7fb98e;--warn:#e8a87c;--bad:#d68a8a;--ff-serif:'Playfair Display',Georgia,serif;--ff-sans:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;--rs:8px;--rm:12px;--rl:16px;--ease:cubic-bezier(0.22,1,0.36,1)}
*{box-sizing:border-box;margin:0;padding:0}
html,body{background:var(--bg);color:var(--text);font-family:var(--ff-sans);line-height:1.6;min-height:100%}
body{padding-bottom:80px}

/* ---------- nav (matches index.html) ---------- */
.nav{position:sticky;top:0;z-index:50;background:rgba(11,10,8,.92);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);border-bottom:1px solid var(--border);padding:14px 24px}
.nav-inner{max-width:1280px;margin:0 auto;display:flex;align-items:center;justify-content:space-between;gap:24px}
.nav-brand{font-family:var(--ff-serif);font-size:1.05rem;color:var(--text);text-decoration:none;font-weight:500;letter-spacing:.02em}
.nav-brand .accent{color:var(--gold)}
.nav-links{display:flex;align-items:center;gap:20px;list-style:none}
.nav-links a{font-size:.78rem;color:var(--text2);text-decoration:none;transition:color .2s;letter-spacing:.05em}
.nav-links a:hover{color:var(--text)}
.nav-links a.active{color:var(--gold)}

/* ---------- layout ---------- */
.wrap{max-width:1280px;margin:0 auto;padding:32px 24px}
.head{margin-bottom:32px}
.head h1{font-family:var(--ff-serif);font-size:clamp(1.8rem,4vw,2.4rem);font-weight:500;letter-spacing:-.02em;color:var(--text);margin-bottom:6px}
.head p{font-size:.85rem;color:var(--text2)}

/* ---------- counts panel ---------- */
.counts{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin-bottom:24px}
.count{background:var(--card);border:1px solid var(--border);border-radius:var(--rl);padding:16px 18px}
.count-label{font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:var(--text3);margin-bottom:6px}
.count-num{font-family:var(--ff-serif);font-size:1.8rem;color:var(--text);line-height:1}
.count.open .count-num{color:var(--warn)}
.count.approved .count-num{color:var(--ok)}
.count.rejected .count-num{color:var(--bad)}

/* ---------- filters ---------- */
.filt-row{display:flex;flex-wrap:wrap;align-items:center;gap:10px;background:var(--surface);border:1px solid var(--border);border-radius:var(--rl);padding:14px;margin-bottom:20px}
.filt-row label{font-size:.65rem;letter-spacing:.1em;text-transform:uppercase;color:var(--text3);margin-right:4px}
.filt-row select,.filt-row input{font-family:var(--ff-sans);font-size:.8rem;padding:7px 12px;border-radius:100px;border:1px solid var(--border);background:var(--bg);color:var(--text);outline:none;transition:all .2s}
.filt-row select:focus,.filt-row input:focus{border-color:var(--gold)}
.filt-row input[type=number]{width:90px}
.filt-row input[type=text]{min-width:200px;flex:1}
.filt-row button{font-family:var(--ff-sans);font-size:.72rem;font-weight:500;padding:8px 16px;border-radius:100px;border:1px solid var(--border);background:transparent;color:var(--text2);cursor:pointer;transition:all .2s var(--ease);letter-spacing:.05em}
.filt-row button:hover{color:var(--text);border-color:var(--text2)}
.filt-row button.primary{background:var(--gold);color:var(--bg);border-color:var(--gold)}
.filt-row button.primary:hover{background:var(--gold-h);border-color:var(--gold-h);color:var(--bg)}

/* ---------- table ---------- */
.table-wrap{background:var(--card);border:1px solid var(--border);border-radius:var(--rl);overflow:hidden}
table{width:100%;border-collapse:collapse;font-size:.8rem}
thead th{font-size:.65rem;letter-spacing:.15em;text-transform:uppercase;color:var(--text3);font-weight:500;text-align:left;padding:14px 16px;background:var(--surface);border-bottom:1px solid var(--border);position:sticky;top:0}
tbody td{padding:14px 16px;border-bottom:1px solid var(--border);vertical-align:top;color:var(--text2)}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover{background:var(--surface)}
.col-id{font-family:'SF Mono',Menlo,monospace;font-size:.7rem;color:var(--text3);max-width:120px;word-break:break-all}
.col-title{color:var(--text);font-family:var(--ff-serif);font-size:.95rem;font-weight:400;max-width:280px}
.col-meta{font-size:.7rem;color:var(--text3)}
.col-conf{font-family:'SF Mono',Menlo,monospace;font-size:.8rem;color:var(--text)}
.col-reason{font-size:.7rem}
.col-actions{white-space:nowrap;text-align:right}
.col-actions button{font-family:var(--ff-sans);font-size:.7rem;font-weight:500;padding:6px 12px;border-radius:100px;border:1px solid var(--border);background:transparent;color:var(--text2);cursor:pointer;transition:all .2s;margin-left:6px}
.col-actions button:hover{color:var(--text);border-color:var(--text2)}
.col-actions button.ok{color:var(--ok);border-color:rgba(127,185,142,.35)}
.col-actions button.ok:hover{background:var(--ok);color:var(--bg);border-color:var(--ok)}
.col-actions button.bad{color:var(--bad);border-color:rgba(214,138,138,.35)}
.col-actions button.bad:hover{background:var(--bad);color:var(--bg);border-color:var(--bad)}
.col-actions button:disabled{opacity:.4;cursor:not-allowed}

.badge{display:inline-block;font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;padding:3px 8px;border-radius:100px;border:1px solid var(--border);color:var(--text3)}
.badge.s-open{color:var(--warn);border-color:rgba(232,168,124,.35)}
.badge.s-approved{color:var(--ok);border-color:rgba(127,185,142,.35)}
.badge.s-rejected{color:var(--bad);border-color:rgba(214,138,138,.35)}

.snapshot-btn{background:none;border:none;color:var(--text3);cursor:pointer;font-size:.7rem;padding:2px 6px;border-radius:var(--rs);transition:color .2s}
.snapshot-btn:hover{color:var(--gold)}
.snapshot-row{display:none;background:var(--surface)}
.snapshot-row.open{display:table-row}
.snapshot-cell{padding:16px 24px;border-bottom:1px solid var(--border)}
.snapshot-cell pre{font-family:'SF Mono',Menlo,monospace;font-size:.72rem;color:var(--text2);background:var(--bg);padding:14px;border-radius:var(--rs);overflow-x:auto;max-height:300px;line-height:1.5}

/* ---------- reject inline note ---------- */
.reject-note{display:none;margin-top:8px}
.reject-note.open{display:block}
.reject-note input{font-family:var(--ff-sans);font-size:.75rem;padding:6px 10px;border-radius:var(--rs);border:1px solid var(--border);background:var(--bg);color:var(--text);outline:none;width:100%;margin-bottom:6px}
.reject-note input:focus{border-color:var(--bad)}
.reject-note button{font-size:.7rem;padding:5px 12px;border-radius:100px;border:1px solid var(--bad);background:var(--bad);color:var(--bg);cursor:pointer;margin-right:4px;font-family:var(--ff-sans);font-weight:500}
.reject-note button.cancel{background:transparent;color:var(--text3);border-color:var(--border)}

/* ---------- empty + loading ---------- */
.empty,.loading{padding:60px 20px;text-align:center;color:var(--text3);font-size:.85rem}
.loading::before{content:'';display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--gold);margin-right:8px;animation:pulse 1.2s infinite}
@keyframes pulse{0%,100%{opacity:.3;transform:scale(.8)}50%{opacity:1;transform:scale(1)}}

/* ---------- toast ---------- */
.toast{position:fixed;bottom:24px;right:24px;background:var(--card);border:1px solid var(--border);border-radius:var(--rl);padding:12px 16px;font-size:.8rem;color:var(--text);box-shadow:0 8px 30px rgba(0,0,0,.5);z-index:100;opacity:0;transform:translateY(20px);transition:all .3s var(--ease);pointer-events:none;max-width:340px}
.toast.show{opacity:1;transform:translateY(0)}
.toast.ok{border-left:3px solid var(--ok)}
.toast.bad{border-left:3px solid var(--bad)}

@media(max-width:760px){
  .filt-row{flex-direction:column;align-items:stretch}
  .filt-row input[type=text]{min-width:0;width:100%}
  table{font-size:.75rem}
  thead th,tbody td{padding:10px 8px}
  .col-id{display:none}
}
</style>
</head>
<body>

<nav class="nav">
  <div class="nav-inner">
    <a class="nav-brand" href="/">Chamonix <span class="accent">Events</span></a>
    <ul class="nav-links">
      <li><a href="/">Events</a></li>
      <li><a href="/about.html">About</a></li>
      <li><a href="/review.html" class="active">Review Queue</a></li>
      <li><a href="/healthz" target="_blank">Health</a></li>
    </ul>
  </div>
</nav>

<div class="wrap">

<header class="head">
  <h1>Review queue</h1>
  <p>Events below the publish threshold (T26). Approve to mark as reviewed-yes; reject with a note to remove from consideration.</p>
</header>

<section class="counts" id="counts">
  <div class="count open"><div class="count-label">Open</div><div class="count-num" id="count-open">—</div></div>
  <div class="count approved"><div class="count-label">Approved</div><div class="count-num" id="count-approved">—</div></div>
  <div class="count rejected"><div class="count-label">Rejected</div><div class="count-num" id="count-rejected">—</div></div>
</section>

<section class="filt-row">
  <label for="f-status">Status</label>
  <select id="f-status">
    <option value="open" selected>Open</option>
    <option value="approved">Approved</option>
    <option value="rejected">Rejected</option>
    <option value="all">All</option>
  </select>

  <label for="f-source">Source</label>
  <select id="f-source"><option value="">All sources</option></select>

  <label for="f-min">Conf ≥</label>
  <input id="f-min" type="number" step="0.05" min="0" max="1" placeholder="0.0">

  <label for="f-max">Conf ≤</label>
  <input id="f-max" type="number" step="0.05" min="0" max="1" placeholder="1.0">

  <label for="f-search">Title</label>
  <input id="f-search" type="text" placeholder="search...">

  <button class="primary" id="btn-refresh">Refresh</button>
</section>

<section class="table-wrap">
  <table>
    <thead>
      <tr>
        <th class="col-id">ID</th>
        <th>Source</th>
        <th>Title / Date</th>
        <th>Confidence</th>
        <th>Reason</th>
        <th class="col-actions">Actions</th>
      </tr>
    </thead>
    <tbody id="rows">
      <tr><td colspan="6" class="loading">Loading</td></tr>
    </tbody>
  </table>
</section>

</div>

<div class="toast" id="toast"></div>

<script>
const API_BASE = '';  // same-origin
const $ = (s) => document.querySelector(s);
const $$ = (s) => Array.from(document.querySelectorAll(s));

const state = {
  status: 'open',
  source: '',
  minConf: null,
  maxConf: null,
  search: '',
  items: [],
};

function toast(msg, kind) {
  const t = $('#toast');
  t.textContent = msg;
  t.className = 'toast show ' + (kind || '');
  clearTimeout(toast._t);
  toast._t = setTimeout(() => t.classList.remove('show'), 3500);
}

async function api(path, opts) {
  const r = await fetch(API_BASE + path, opts);
  if (!r.ok) {
    let body = null;
    try { body = await r.json(); } catch (e) {}
    throw new Error((body && body.error) || ('HTTP ' + r.status));
  }
  return await r.json();
}

async function loadCounts() {
  try {
    const c = await api('/api/review/counts');
    $('#count-open').textContent = c.open || 0;
    $('#count-approved').textContent = c.approved || 0;
    $('#count-rejected').textContent = c.rejected || 0;
  } catch (e) { /* ignore */ }
}

async function loadSources() {
  try {
    const r = await api('/api/review/sources');
    const sel = $('#f-source');
    // Remove existing options beyond first
    while (sel.children.length > 1) sel.removeChild(sel.lastChild);
    for (const s of (r.sources || [])) {
      const o = document.createElement('option');
      o.value = s; o.textContent = s;
      sel.appendChild(o);
    }
  } catch (e) { /* ignore */ }
}

function fmtDate(s) {
  if (!s) return '—';
  try {
    const d = new Date(s);
    if (isNaN(d.getTime())) return s;
    return d.toISOString().slice(0, 10);
  } catch (e) { return s; }
}

function fmtAge(iso) {
  if (!iso) return '—';
  try {
    const d = new Date(iso);
    const ms = Date.now() - d.getTime();
    if (ms < 0) return 'just now';
    const m = Math.round(ms / 60000);
    if (m < 60) return m + 'm';
    const h = Math.round(m / 60);
    if (h < 24) return h + 'h';
    return Math.round(h / 24) + 'd';
  } catch (e) { return '—'; }
}

function esc(s) {
  if (s == null) return '';
  return String(s).replace(/[&<>"']/g, c => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;'
  })[c]);
}

function statusBadge(status) {
  const cls = 's-' + (status || 'open');
  return `<span class="badge ${cls}">${esc(status || 'open')}</span>`;
}

function renderRow(item) {
  const ev = item.event || {};
  const title = ev.title || '(untitled)';
  const date = fmtDate(ev.start_date);
  const venue = ev.venue_name || '';
  const conf = item.confidence != null ? Number(item.confidence).toFixed(3) : '—';
  const reason = item.reason || '—';
  const src = item.source_id || '—';
  const rid = item.id || '';
  const status = item.status || 'open';
  const age = fmtAge(item.created_at);
  const decided = status !== 'open';
  const reviewer = item.reviewed_by ? ` <span class="col-meta">by ${esc(item.reviewed_by)} ${fmtAge(item.reviewed_at)}</span>` : '';
  const notes = item.notes ? `<div class="col-meta" style="margin-top:4px">📝 ${esc(item.notes)}</div>` : '';

  const actions = decided
    ? `<span class="col-meta">${statusBadge(status)}${reviewer}</span>`
    : `<button class="ok" data-action="approve" data-id="${rid}">Approve</button>
       <button class="bad" data-action="reject" data-id="${rid}">Reject</button>`;

  return `
    <tr data-id="${rid}">
      <td class="col-id">${esc(rid)}</td>
      <td><span class="badge">${esc(src)}</span><div class="col-meta" style="margin-top:4px">${age} ago</div></td>
      <td class="col-title">${esc(title)}
        <div class="col-meta">${esc(date)}${venue ? ' · ' + esc(venue) : ''}</div>
        <button class="snapshot-btn" data-action="snapshot" data-id="${rid}">▸ snapshot</button>
      </td>
      <td class="col-conf">${conf}</td>
      <td class="col-reason">${esc(reason)}${notes}</td>
      <td class="col-actions">${actions}</td>
    </tr>
    <tr class="snapshot-row" data-snap="${rid}">
      <td colspan="6" class="snapshot-cell">
        <pre>${esc(JSON.stringify(ev, null, 2))}</pre>
      </td>
    </tr>
    <tr class="reject-row" data-reject="${rid}">
      <td colspan="6">
        <div class="reject-note" id="reject-${rid}">
          <input type="text" placeholder="reason for rejection (required)..." data-input="${rid}">
          <button data-action="reject-confirm" data-id="${rid}">Confirm reject</button>
          <button class="cancel" data-action="reject-cancel" data-id="${rid}">Cancel</button>
        </div>
      </td>
    </tr>
  `;
}

async function loadItems() {
  const tbody = $('#rows');
  tbody.innerHTML = '<tr><td colspan="6" class="loading">Loading</td></tr>';

  const params = new URLSearchParams();
  params.set('status', state.status);
  if (state.source) params.set('source', state.source);
  if (state.minConf !== null && state.minConf !== '') params.set('min_conf', state.minConf);
  if (state.maxConf !== null && state.maxConf !== '') params.set('max_conf', state.maxConf);
  params.set('limit', '200');

  try {
    const r = await api('/api/review?' + params.toString());
    let items = r.items || [];

    // Client-side title search (API doesn't expose free-text yet)
    if (state.search) {
      const q = state.search.toLowerCase();
      items = items.filter(it => {
        const ev = it.event || {};
        return (ev.title || '').toLowerCase().includes(q)
            || (ev.description || '').toLowerCase().includes(q);
      });
    }

    state.items = items;
    if (!items.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="empty">No items match the current filter.</td></tr>';
      return;
    }
    tbody.innerHTML = items.map(renderRow).join('');
  } catch (e) {
    tbody.innerHTML = '<tr><td colspan="6" class="empty">Error: ' + esc(e.message) + '</td></tr>';
  }
}

async function decide(rid, action, note) {
  try {
    const r = await api('/api/review/' + rid + '/' + action, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ note: note || '', by: 'web-ui' }),
    });
    toast(action + 'd', 'ok');
    await Promise.all([loadCounts(), loadItems()]);
  } catch (e) {
    toast(e.message || 'failed', 'bad');
  }
}

// ---------- event wiring ----------

$('#btn-refresh').addEventListener('click', loadItems);

['f-status', 'f-source'].forEach(id => {
  $('#' + id).addEventListener('change', () => {
    state.status = $('#f-status').value;
    state.source = $('#f-source').value;
    loadItems();
  });
});

['f-min', 'f-max'].forEach(id => {
  $('#' + id).addEventListener('change', () => {
    state.minConf = $('#f-min').value;
    state.maxConf = $('#f-max').value;
    loadItems();
  });
});

let searchT;
$('#f-search').addEventListener('input', () => {
  state.search = $('#f-search').value;
  clearTimeout(searchT);
  searchT = setTimeout(loadItems, 250);
});

// Table action delegation
$('#rows').addEventListener('click', (e) => {
  const btn = e.target.closest('[data-action]');
  if (!btn) return;
  const action = btn.dataset.action;
  const rid = btn.dataset.id;

  if (action === 'snapshot') {
    const snap = document.querySelector('[data-snap="' + rid + '"]');
    if (snap) {
      snap.classList.toggle('open');
      btn.textContent = snap.classList.contains('open') ? '▾ snapshot' : '▸ snapshot';
    }
    return;
  }
  if (action === 'approve') {
    decide(rid, 'approve');
    return;
  }
  if (action === 'reject') {
    // Open inline note row
    const r = document.querySelector('[data-reject="' + rid + '"] .reject-note');
    if (r) r.classList.add('open');
    const inp = document.querySelector('[data-input="' + rid + '"]');
    if (inp) inp.focus();
    return;
  }
  if (action === 'reject-cancel') {
    const r = document.querySelector('[data-reject="' + rid + '"] .reject-note');
    if (r) r.classList.remove('open');
    return;
  }
  if (action === 'reject-confirm') {
    const inp = document.querySelector('[data-input="' + rid + '"]');
    const note = inp ? inp.value.trim() : '';
    if (!note) {
      toast('note required to reject', 'bad');
      return;
    }
    decide(rid, 'reject', note);
    return;
  }
});

// initial load
loadCounts();
loadSources();
loadItems();

// light auto-refresh of counts every 30s
setInterval(() => { loadCounts(); }, 30000);
</script>
</body>
</html>