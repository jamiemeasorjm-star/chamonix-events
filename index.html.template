.cinema-row-poster .no-img{width:100%;height:100%;display:flex;align-items:center;justify-content:center;font-size:1.5rem;color:var(--text3);font-family:var(--ff-serif)}
.cinema-row-info{display:flex;flex-direction:column;gap:8px}
