.cinema-row-times .time-btn.past{opacity:.35;cursor:default}
.cinema-row-times .time-btn.past:hover{background:transparent;border-color:var(--border-a);color:var(--text3)}
.cinema-row-times .time-btn.now{background:var(--gold-d);border-color:var(--gold);color:var(--gold)}
@media(max-width:768px){.cinema-row{grid-template-columns:56px 1fr;gap:12px;padding:16px 12px}.cinema-row-poster{width:56px;height:84px}.cinema-row-title{font-size:.9rem}}
