<!DOCTYPE html><html lang="fr"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chamonix Events</title>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Playfair+Display:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
<style>
*{margin:0;padding:0;box-sizing:border-box}
:root{--bg:#0b0a08;--surface:#141210;--card:#1a1815;--border:rgba(255,255,255,0.06);--border-a:rgba(200,164,92,0.25);--text:#ede8e0;--text2:#9a948c;--text3:#6b6660;--gold:#c8a45c;--gold-h:#d4b46a;--gold-d:rgba(200,164,92,0.15);--ff-serif:'Playfair Display',Georgia,serif;--ff-sans:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;--rs:8px;--rm:12px;--rl:16px;--ease:cubic-bezier(0.22,1,0.36,1)}
html{font-size:16px;-webkit-font-smoothing:antialiased;scroll-behavior:smooth}
body{font-family:var(--ff-sans);background:var(--bg);color:var(--text);line-height:1.6;overflow-x:hidden}
::selection{background:var(--gold-d);color:var(--text)}
.nav{position:fixed;top:0;left:0;right:0;z-index:100;padding:20px 24px;transition:all .4s var(--ease)}
.nav.scrolled{background:rgba(11,10,8,.88);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);padding:12px 24px;border-bottom:1px solid var(--border)}
.nav-inner{max-width:1200px;margin:0 auto;display:flex;align-items:center;justify-content:space-between}
.nav-links{display:flex;align-items:center;gap:24px;list-style:none}
.nav-links a{font-size:.8rem;color:var(--text2);text-decoration:none;transition:color .2s;letter-spacing:.05em}
.nav-links a:hover{color:var(--text)}
.hamburger{display:none;flex-direction:column;gap:5px;cursor:pointer;padding:4px;background:none;border:none}
.hamburger span{display:block;width:22px;height:2px;background:var(--text);border-radius:2px;transition:all .3s var(--ease);transform-origin:center}
.hero{position:relative;min-height:70vh;display:flex;flex-direction:column;justify-content:flex-start;padding:100px 24px 60px;overflow:hidden}
.hero-bg{position:absolute;inset:0;background:radial-gradient(ellipse 80% 60% at 50% 20%,rgba(200,164,92,.1) 0%,transparent 60%),radial-gradient(ellipse 60% 50% at 80% 80%,rgba(200,164,92,.05) 0%,transparent 50%),linear-gradient(180deg,var(--bg) 0%,#0e0d0a 40%,#13100c 60%,transparent 100%);z-index:0}
.hero-gd{position:absolute;inset:0;background-image:linear-gradient(rgba(255,255,255,.015) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,.015) 1px,transparent 1px);background-size:60px 60px;z-index:0;opacity:.3;-webkit-mask-image:linear-gradient(180deg,rgba(0,0,0,.4) 0%,rgba(0,0,0,.4) 50%,transparent 100%);mask-image:linear-gradient(180deg,black 0%,black 50%,transparent 100%)}
.hero-c{position:relative;z-index:1;max-width:1200px;margin:0 auto;width:100%}
.hero-label{display:inline-block;font-size:.65rem;letter-spacing:.25em;text-transform:uppercase;color:var(--gold);border:1px solid var(--gold-d);padding:3px 10px;border-radius:100px;margin-bottom:16px;opacity:0;animation:fadeU .8s var(--ease) .3s forwards}
.hero-title{font-family:var(--ff-serif);font-size:clamp(2.4rem,8vw,5.5rem);font-weight:500;line-height:.95;letter-spacing:-.03em;color:var(--text);margin-bottom:10px;opacity:0;animation:fadeU .8s var(--ease) .5s forwards}
.hero-sub{font-size:clamp(.95rem,2vw,1.15rem);color:var(--text2);max-width:480px;line-height:1.6;margin-bottom:0;opacity:0;animation:fadeU .8s var(--ease) .7s forwards}
.hero-scroll{position:absolute;bottom:24px;left:0;right:0;margin:0 auto;width:fit-content;display:flex;flex-direction:column;align-items:center;gap:6px;opacity:0;animation:fadeU .8s var(--ease) 1.2s forwards}
.hero-scroll-l{width:1px;height:40px;background:linear-gradient(180deg,var(--text3) 0%,transparent 100%);animation:sP 2s ease-in-out infinite}
.hero-scroll-t{font-size:.6rem;letter-spacing:.2em;text-transform:uppercase;color:var(--text3)}
@keyframes fadeU{from{opacity:0;transform:translateY(20px)}to{opacity:1;transform:translateY(0)}}
@keyframes sP{0%,100%{opacity:.3}50%{opacity:1}}
.sec{padding:80px 24px;max-width:1200px;margin:0 auto}
.sec-h{margin-bottom:48px}
.sec-l{font-size:.65rem;letter-spacing:.25em;text-transform:uppercase;color:var(--gold);margin-bottom:8px}
.sec-t{font-family:var(--ff-serif);font-size:clamp(1.8rem,4vw,2.8rem);font-weight:400;line-height:1.15}
.flt-row{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:12px;align-items:center}
.flt-row .srch-w{position:relative;flex:1;min-width:200px;max-width:320px}
.flt-row .srch-w svg{position:absolute;left:12px;top:50%;transform:translateY(-50%);width:14px;height:14px;color:var(--text3);fill:none;stroke:currentColor;stroke-width:2;pointer-events:none}
.flt-row .srch{width:100%;font-family:var(--ff-sans);font-size:.75rem;padding:9px 12px 9px 32px;border-radius:100px;border:1px solid var(--border);background:transparent;color:var(--text);outline:none;transition:all .3s}
.flt-row .srch:focus{border-color:var(--text3)}
.flt-row .srch::placeholder{color:var(--text3)}
.quick-filts{display:flex;gap:6px;flex-wrap:wrap}
.qfilt{font-family:var(--ff-sans);font-size:.7rem;padding:6px 14px;border-radius:100px;border:1px dashed var(--border);background:transparent;color:var(--text3);cursor:pointer;transition:all .3s}
.qfilt:hover{border-color:var(--gold-d);color:var(--gold)}
.qfilt.on{border-color:var(--gold);color:var(--gold);background:var(--gold-d);border-style:solid}
.filts{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:12px;align-items:center}
.filt{font-family:var(--ff-sans);font-size:.75rem;font-weight:500;padding:8px 18px;border-radius:100px;border:1px solid var(--border);background:transparent;color:var(--text2);cursor:pointer;transition:all .3s var(--ease)}
.filt:hover{border-color:var(--text3);color:var(--text)}
.filt.on{background:var(--gold);border-color:var(--gold);color:var(--bg)}
.filt.date{border-style:dashed;font-size:.7rem;padding:8px 14px;min-width:110px;color-scheme:dark}
.filt.map-toggle{color:var(--gold);border-color:var(--gold-d)}.filt.map-toggle.on{background:var(--gold);color:var(--text);border-color:#fff;border-style:solid}
.cnt{width:100%;font-size:.8rem;color:var(--text3);margin-top:8px;margin-bottom:24px}
.cnt b{color:var(--text2);font-weight:500}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(340px,1fr));gap:24px}
.grid.hidden{display:none}
/* Map */
.map-container{width:100%;height:480px;border-radius:var(--rm);overflow:hidden;border:1px solid var(--border);display:none}
.map-container.show{display:block}
.map-container .leaflet-container{background:var(--bg)!important;font-family:var(--ff-sans)!important}
.map-container .leaflet-popup-content-wrapper{background:var(--card)!important;color:var(--text)!important;border-radius:var(--rs)!important;box-shadow:0 4px 20px rgba(0,0,0,.5)!important;border:1px solid var(--border)!important}
.map-container .leaflet-popup-tip{background:var(--card)!important;border:1px solid var(--border)!important}
.map-container .leaflet-popup-content{margin:10px 14px!important;font-size:.75rem!important;line-height:1.4!important;min-width:180px}
.map-container .leaflet-popup-content strong{font-family:var(--ff-serif);font-size:.85rem;display:block;margin-bottom:4px}
.map-container .leaflet-popup-content .popup-cat{font-size:.55rem;letter-spacing:.1em;text-transform:uppercase;color:var(--gold)}
.map-container .leaflet-popup-content .popup-date{font-size:.65rem;color:var(--text3);margin-top:4px}
.map-container .leaflet-popup-close-button{color:var(--text3)!important}
.card{position:relative;background:var(--card);border-radius:var(--rl);overflow:hidden;border:1px solid var(--border);cursor:pointer;transition:all .5s var(--ease);opacity:0;transform:translateY(30px)}
.card.in{opacity:1;transform:translateY(0)}
.card:hover{border-color:var(--border-a);box-shadow:0 8px 40px rgba(0,0,0,.4);transform:translateY(-4px)}
.card:active{transform:translateY(-2px)}
.card-img{position:relative;width:100%;aspect-ratio:16/10;overflow:hidden;background:var(--surface)}
.card-img img{width:100%;height:100%;object-fit:cover;transition:transform .8s var(--ease)}
.card:hover .card-img img{transform:scale(1.05)}
.card-img-f{width:100%;height:100%;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--surface) 0%,var(--card) 100%);font-family:var(--ff-serif);font-size:2rem;color:var(--text3)}
.card-img-o{position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(11,10,8,.4) 100%);pointer-events:none;z-index:1}
.card-date{position:absolute;top:16px;left:16px;background:rgba(11,10,8,.85);backdrop-filter:blur(12px);-webkit-backdrop-filter:blur(12px);border:1px solid rgba(255,255,255,.08);border-radius:var(--rs);padding:6px 14px;text-align:center;min-width:52px;z-index:2}
.card-date .dy{font-family:var(--ff-serif);font-size:1.4rem;line-height:1;font-weight:400}
.card-date .mo{font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:var(--gold);margin-top:2px}
.card-tag{position:absolute;top:16px;right:16px;background:var(--gold);color:var(--bg);font-size:.6rem;font-weight:600;letter-spacing:.1em;text-transform:uppercase;padding:4px 10px;border-radius:100px;z-index:2}
.card-body{padding:20px}
.card-meta{display:flex;align-items:center;gap:12px;margin-bottom:8px;flex-wrap:wrap}
.card-cat{font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;font-weight:500}
.card-cat.c{color:var(--gold)}.card-cat.cC{color:#93a8d6}.card-cat.cE{color:#e8a87c}.card-cat.cF{color:#a8d6a0}
.card-cat.cM{color:#d6c8a0}.card-cat.cP{color:#c0a0d6}.card-cat.cS{color:#a0d6c8}.card-cat.cT{color:#d6a0a8}
.card-dot{width:3px;height:3px;border-radius:50%;background:var(--text3);flex-shrink:0}
.card-venue{font-size:.7rem;color:var(--text3)}
.card-title{font-family:var(--ff-serif);font-size:1.15rem;font-weight:400;line-height:1.25;margin-bottom:12px}
.card-desc{font-size:.8rem;color:var(--text2);line-height:1.5;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;margin-bottom:16px}
.card-ft{display:flex;align-items:center;justify-content:space-between}
.card-cta{font-size:.7rem;color:var(--gold);text-decoration:none;display:inline-flex;align-items:center;gap:6px;transition:gap .3s var(--ease);background:none;border:none;cursor:pointer;font-family:var(--ff-sans)}
.card:hover .card-cta{gap:10px}
.mt{text-align:center;padding:60px 20px;grid-column:1/-1}
.mt-i{font-size:2rem;color:var(--text3);margin-bottom:16px;opacity:.4}
.mt-t{font-family:var(--ff-serif);font-size:1.2rem;color:var(--text2);margin-bottom:8px}
.mt-d{font-size:.85rem;color:var(--text3);max-width:320px;margin:0 auto}
.mt-b{display:inline-block;margin-top:20px;padding:8px 24px;border:1px solid var(--border);border-radius:100px;font-size:.75rem;color:var(--text2);background:transparent;cursor:pointer;transition:all .3s}
.mt-b:hover{border-color:var(--text3);color:var(--text)}
.sec-v{background:var(--surface);border-top:1px solid var(--border);border-bottom:1px solid var(--border)}
.ven-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:20px}
.ven-card{background:var(--card);border-radius:var(--rm);border:1px solid var(--border);overflow:hidden;cursor:pointer;transition:all .4s var(--ease)}
.ven-card:hover{border-color:var(--border-a);transform:translateY(-3px);box-shadow:0 6px 30px rgba(0,0,0,.3)}
.ven-card-img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block;background:var(--surface)}
.ven-card-img-f{width:100%;aspect-ratio:16/9;display:flex;align-items:center;justify-content:center;background:linear-gradient(135deg,var(--surface) 0%,var(--card) 100%);font-size:2.5rem;color:var(--text3)}
.ven-card-body{padding:16px}
.ven-card-name{font-family:var(--ff-serif);font-size:.95rem;font-weight:400;margin-bottom:4px}
.ven-card-meta{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:4px}
.ven-card-type{font-size:.6rem;letter-spacing:.1em;text-transform:uppercase;color:var(--gold)}
.ven-card-loc{font-size:.65rem;color:var(--text3)}
.ven-card-count{font-size:.7rem;color:var(--text2);margin-top:4px}
.ven-card-cats{display:flex;gap:4px;flex-wrap:wrap;margin-top:6px}
.ven-card-cat{font-size:.55rem;letter-spacing:.1em;text-transform:uppercase;padding:2px 8px;border-radius:100px;border:1px solid var(--border);color:var(--text3)}
.ven-spotlight{padding:80px 24px;max-width:1200px;margin:0 auto;display:grid;grid-template-columns:1.1fr .9fr;gap:60px;align-items:center}
.ven-spotlight-img{border-radius:var(--rl);overflow:hidden;aspect-ratio:4/3;background:var(--card);position:relative}
.ven-spotlight-img img{width:100%;height:100%;object-fit:cover}
.ven-spotlight-img-o{position:absolute;inset:0;background:linear-gradient(180deg,transparent 50%,rgba(11,10,8,.6) 100%)}
.ven-badge{display:inline-flex;align-items:center;gap:6px;background:var(--gold-d);border:1px solid var(--gold);padding:4px 12px;border-radius:100px;font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;color:var(--gold);margin-bottom:16px}
.ven-badge svg{width:12px;height:12px;fill:none;stroke:currentColor;stroke-width:2}
.ven-spotlight-t{font-family:var(--ff-serif);font-size:clamp(1.8rem,3vw,2.4rem);font-weight:400;margin-bottom:8px}
.ven-spotlight-l{font-size:.75rem;color:var(--text2);margin-bottom:20px}
.ven-spotlight-d{font-size:.9rem;color:var(--text2);line-height:1.7;margin-bottom:24px}
.ven-features{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:28px}
.ven-feat{display:flex;align-items:center;gap:10px;font-size:.8rem;color:var(--text2)}
.ven-feat-icon{width:32px;height:32px;background:var(--gold-d);border-radius:50%;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ven-feat-icon svg{width:14px;height:14px;color:var(--gold);fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.btt{position:fixed;bottom:32px;right:32px;z-index:50;width:40px;height:40px;border-radius:50%;background:rgba(200,164,92,.12);border:1px solid var(--gold-d);color:var(--gold);cursor:pointer;display:flex;align-items:center;justify-content:center;opacity:0;visibility:hidden;transform:translateY(12px);transition:all .4s var(--ease);backdrop-filter:blur(8px)}
.btt.show{opacity:1;visibility:visible;transform:translateY(0)}
.btt:hover{background:var(--gold-d);border-color:var(--gold)}
.btt svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round}
.ftr{border-top:1px solid var(--border);padding:48px 24px;max-width:1200px;margin:0 auto}
.ftr-in{display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px}
.ftr-br{font-family:var(--ff-serif);font-size:.9rem;letter-spacing:.12em;color:var(--text3);font-weight:500}
.ftr-lk{display:flex;gap:24px}
.ftr-lk a{font-size:.75rem;color:var(--text3);text-decoration:none;transition:color .2s}
.ftr-lk a:hover{color:var(--text2)}
.ftr-cp{width:100%;text-align:center;font-size:.65rem;color:var(--text3);margin-top:24px}
.fade-in{opacity:0;transform:translateY(40px);transition:opacity .8s var(--ease),transform .8s var(--ease)}
.fade-in.in{opacity:1;transform:translateY(0)}
.modal-overlay{position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);z-index:200;opacity:0;visibility:hidden;transition:all .4s var(--ease);display:flex;align-items:flex-end;justify-content:center}
.modal-overlay.open{opacity:1;visibility:visible}
.modal{background:var(--bg);border-radius:var(--rl) var(--rl) 0 0;max-width:640px;width:100%;max-height:85vh;overflow-y:auto;transform:translateY(100%);transition:transform .5s var(--ease);position:relative}
.modal-overlay.open .modal{transform:translateY(0)}
.modal-close{position:absolute;top:16px;right:16px;z-index:10;width:36px;height:36px;background:rgba(11,10,8,.7);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.1);border-radius:50%;cursor:pointer;display:flex;align-items:center;justify-content:center;transition:all .3s}
.modal-close:hover{background:rgba(11,10,8,.9)}
.modal-close svg{width:16px;height:16px;color:var(--text);fill:none;stroke:currentColor;stroke-width:2}
.modal-img{width:100%;aspect-ratio:16/9;object-fit:cover;display:block}
.modal-body{padding:24px}
.modal-meta{display:flex;align-items:center;gap:12px;margin-bottom:12px;flex-wrap:wrap}
.modal-cat{font-size:.6rem;letter-spacing:.15em;text-transform:uppercase;font-weight:500}
.modal-cat.c{color:var(--gold)}.modal-cat.cC{color:#93a8d6}.modal-cat.cE{color:#e8a87c}.modal-cat.cF{color:#a8d6a0}
.modal-cat.cM{color:#d6c8a0}.modal-cat.cP{color:#c0a0d6}.modal-cat.cS{color:#a0d6c8}.modal-cat.cT{color:#d6a0a8}
.modal-dot{width:3px;height:3px;border-radius:50%;background:var(--text3)}
.modal-venue{font-size:.75rem;color:var(--text3)}
.modal-title{font-family:var(--ff-serif);font-size:1.4rem;font-weight:400;line-height:1.25;margin-bottom:16px}
.modal-info{display:flex;flex-wrap:wrap;gap:12px;margin-bottom:20px;padding:16px;background:var(--surface);border-radius:var(--rm);border:1px solid var(--border)}
.modal-info-item{display:flex;align-items:center;gap:8px;font-size:.75rem;color:var(--text2)}
.modal-info-item svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:1.5;flex-shrink:0}
.modal-desc{font-size:.85rem;color:var(--text2);line-height:1.7;margin-bottom:20px}
.modal-address{font-size:.75rem;color:var(--text3);line-height:1.5;margin-bottom:24px}
.modal-actions{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:16px}
.modal-source{display:inline-flex;align-items:center;gap:8px;font-size:.75rem;color:var(--gold);text-decoration:none;padding:10px 20px;border:1px solid var(--gold-d);border-radius:100px;transition:all .3s}
.modal-source:hover{background:var(--gold-d);border-color:var(--gold)}
.modal-source svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2}
.modal-share{display:inline-flex;align-items:center;gap:8px;font-size:.75rem;color:var(--text2);padding:10px 20px;border:1px solid var(--border);border-radius:100px;background:transparent;cursor:pointer;transition:all .3s;font-family:var(--ff-sans)}
.modal-share:hover{border-color:var(--text3);color:var(--text)}
.modal-share svg{width:14px;height:14px;fill:none;stroke:currentColor;stroke-width:2}
.modal-showtimes h4{font-size:.75rem;font-weight:500;color:var(--text);margin-bottom:8px}
.modal-showtimes table{width:100%;border-collapse:collapse;font-size:.75rem}
.modal-showtimes td{padding:6px 0;color:var(--text2);border-bottom:1px solid var(--border)}
.modal-showtimes td:last-child{text-align:right;color:var(--text)}
::-webkit-scrollbar{width:4px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:var(--border);border-radius:4px}
::-webkit-scrollbar-thumb:hover{background:var(--text3)}
@media(max-width:768px){.hero{min-height:60vh;padding:80px 20px 40px}.grid{grid-template-columns:1fr;gap:20px}.ven-grid{grid-template-columns:1fr;gap:16px}.ven-spotlight{grid-template-columns:1fr;gap:32px}.ven-features{grid-template-columns:1fr}.sec{padding:60px 20px}.filts{gap:6px}.filt{font-size:.7rem;padding:6px 14px}.filt.date{min-width:90px}.flt-row .srch-w{max-width:100%}.sec-h{margin-bottom:32px}.ven-spotlight{padding:60px 20px}.nav-links{display:none}.hamburger{display:flex}.nav-links.open{display:flex;position:fixed;top:56px;left:0;right:0;flex-direction:column;background:rgba(11,10,8,.95);backdrop-filter:blur(20px);padding:20px 24px 24px;gap:16px;border-bottom:1px solid var(--border)}.btt{bottom:20px;right:20px;width:36px;height:36px}.modal{max-height:90vh}.modal-body{padding:20px}.modal-info{gap:10px}.modal-actions{flex-direction:column}.modal-actions a,.modal-actions button{width:100%;justify-content:center}.map-container{height:360px}}
@media(max-width:480px){.hero{min-height:50vh;padding:70px 16px 40px}.modal-title{font-size:1.2rem}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}}

.preloader{position:fixed;inset:0;z-index:9999;display:flex;align-items:center;justify-content:center;background:var(--bg);transition:opacity .6s var(--ease),visibility .6s var(--ease)}.preloader.hidden{opacity:0;visibility:hidden;pointer-events:none}.preloader-inner{text-align:center}.preloader-bar{width:120px;height:2px;background:var(--border);border-radius:2px;overflow:hidden}.preloader-bar-fill{height:100%;width:40%;background:var(--gold);border-radius:2px;animation:preloadBar 1.2s var(--ease) infinite}@keyframes preloadBar{0%{transform:translateX(-100%)}100%{transform:translateX(350%)}}
