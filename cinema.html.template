function t(k){var l=I18N[LOCALE]||I18N['fr'];return l[k]||k;}
// T24: localized event/cinema field reader
function _l(e,f){return e[f+'_'+LOCALE]||e[f];}
function cycleLocale(l){if(l){LOCALE=l}else{var a=['en','fr','es','hu','sv'];var i=a.indexOf(LOCALE);LOCALE=a[(i+1)%a.length]}localStorage.setItem(LOCALE_KEY,LOCALE);if(document.getElementById('locale-sel'))document.getElementById('locale-sel').value=LOCALE;applyCine();}
function applyCine(){
document.querySelectorAll('[data-i18n]').forEach(function(el){var k=el.getAttribute('data-i18n');el.textContent=t(k);});
var btn=document.getElementById('theme-btn');
document.documentElement.lang=LOCALE;
}
</script>
<script>
<!-- CINEMA_DATA -->
var CAT_COLORS = {"Cinema": "cC"};
var CAT_LABELS = {"Cinema": "Cinema"};
function fmt(d){if(!d)return null;try{var dt=new Date(d);if(isNaN(dt.getTime()))return null;return{date:dt,day:t("d"+dt.getDay()),dayNum:dt.getDate(),month:t("m"+dt.getMonth()),iso:dt.toISOString().split("T")[0],display:String(dt.getDate()).padStart(2,"0")+"/"+String(dt.getMonth()+1).padStart(2,"0")+"/"+dt.getFullYear()};}catch{return null}}
function esc(s){return s?s.replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;"):""}
function getCinemaFilms(){
  var films={};
  // Prefer injected CINEMA_EVENTS (separate dataset from vox_pdf.py / cinema_events.json)
  var src=(typeof CINEMA_EVENTS!=='undefined'&&CINEMA_EVENTS&&CINEMA_EVENTS.length)?CINEMA_EVENTS:[];
  if(!src.length){
    // Fallback: legacy path — find cinema events in main EVENTS array
    src=(typeof EVENTS!=='undefined'?EVENTS:[]).filter(function(e){return e.category==='Cinema'||e.category==='cinema';});
  }
  src.forEach(function(e,i){
    // Normalize showtimes: cinema_events.json has it as a dict; SQLite dump may have showtimes_json string
    var st=e.showtimes;
    if(!st&&typeof e.showtimes_json==='string'){try{st=JSON.parse(e.showtimes_json);}catch(_){st={};}}
    if(!st||!Object.keys(st).length)return;
    var titleKey=_l(e,'title');
    var key=(titleKey||e.title||'').trim();
    if(!key)return;
    if(!films[key]){
      films[key]={title:titleKey||e.title,desc:_l(e,'description')||e.description||'',image:e.image_url||'',venue:_l(e,'venue_name')||e.venue||'Le Vox',lang:e.language||'Francais',duration:e.duration||'',source_url:e.source_url||'',showtimes:{},index:i};
    }
    for(var d in st){
      if(!films[key].showtimes[d])films[key].showtimes[d]=[];
      (st[d]||[]).forEach(function(t){
        if(films[key].showtimes[d].indexOf(t)<0)films[key].showtimes[d].push(t);
      });
    }
  });
  return Object.keys(films).map(function(k){return films[k];});
}
function getCinemaDates(films){
  var dates={};
  var today=new Date();today.setHours(0,0,0,0);
  films.forEach(function(f){
    for(var d in f.showtimes){
      var dt=new Date(d+'T12:00:00');
      if(dt<today)continue;
      if(!dates[d])dates[d]=0;
      dates[d]+=f.showtimes[d].length;
    }
  });
  return Object.keys(dates).sort();
}
function isToday(d){
  var now=new Date();return d===now.toISOString().split('T')[0];
}
function fmtDay(dStr){
  var d=new Date(dStr+'T12:00:00');
  var DAYS_SHORT=t('d0')?[t('d0'),t('d1'),t('d2'),t('d3'),t('d4'),t('d5'),t('d6')]:['Dim','Lun','Mar','Mer','Jeu','Ven','Sam'];
  var MONTHS_SHORT=t('m0')?[t('m0'),t('m1'),t('m2'),t('m3'),t('m4'),t('m5'),t('m6'),t('m7'),t('m8'),t('m9'),t('m10'),t('m11')]:['Jan','Fev','Mar','Avr','Mai','Juin','Juil','Aou','Sep','Oct','Nov','Dec'];
  return {dow:DAYS_SHORT[d.getDay()],day:d.getDate(),month:MONTHS_SHORT[d.getMonth()],iso:dStr};
}
function fmtTime(t){
  return t.substring(0,5);
}
function renderCinemaDays(films){
  var el=document.getElementById('cinema-days');
  if(!el)return;
  var dates=getCinemaDates(films);
  if(!dates.length){el.innerHTML='';return;}
  var sel=document.getElementById('cinema-grid').dataset.date||dates[0];
  el.innerHTML=dates.map(function(d){
    var f=fmtDay(d);
    var cls='cinema-day'+(d===sel?' on':'')+(isToday(d)?' today':'');
    return '<button class="'+cls+'" data-date="'+d+'" onclick="selectCinemaDay(\''+d+'\')">'+f.day+'<span class="dow">'+f.dow+'</span></button>';
  }).join('');
  el.scrollLeft=0;
  var selBtn=el.querySelector('.on');
  if(selBtn)selBtn.scrollIntoView({behavior:'smooth',inline:'center',block:'nearest'});
}
function selectCinemaDay(d){
  document.getElementById('cinema-grid').dataset.date=d;
  renderCinemaDays(getCinemaFilms());
  renderCinemaGrid(d);
}
function nextCinemaDay(){
  var films=getCinemaFilms();
  var dates=getCinemaDates(films);
  if(!dates.length)return;
  var cur=document.getElementById('cinema-grid').dataset.date;
  var idx=dates.indexOf(cur);
  var next=idx>=0&&idx<dates.length-1?dates[idx+1]:dates[0];
  selectCinemaDay(next);
}
function renderCinemaGrid(date){
  var el=document.getElementById('cinema-grid');
  var empty=document.getElementById('cinema-empty');
  if(!el)return;
  var films=getCinemaFilms();
  if(!date){date=films.length?getCinemaDates(films)[0]||'':'';}
  el.dataset.date=date;
  var today=new Date();
  var todayStr=today.toISOString().split('T')[0];
  var nowH=today.getHours(),nowM=today.getMinutes();
  var nowTotal=nowH*60+nowM;
  var dayFilms=films.filter(function(f){return f.showtimes[date]&&f.showtimes[date].length;}).sort(function(a,b){var at=a.showtimes[date]?parseInt(a.showtimes[date][0]):'99:99';var bt=b.showtimes[date]?parseInt(b.showtimes[date][0]):'99:99';return at<bt?-1:at>bt?1:0;});
  if(!dayFilms.length){
    el.innerHTML='';empty.style.display='block';return;
  }
  empty.style.display='none';
  el.innerHTML=dayFilms.map(function(f){
    var img=f.image?'<img src="'+esc(f.image)+'" alt="'+esc(_l(f,'title'))+'" loading="lazy">':'<img src="placeholders/cinema.jpg" alt="'+esc(_l(f,'title'))+'" loading="lazy">';
    var isVO=(f.lang&&(f.lang.toLowerCase().indexOf('vo')>=0||f.lang.toLowerCase().indexOf('vost')>=0));
    var langTag=isVO?'<span class="lang vo">VO</span>':'<span class="lang">FR</span>';
    var times=f.showtimes[date].map(function(t){
      var cleanT=t.substring(0,5);
      var parts=cleanT.split(':');
      var tMin=parseInt(parts[0])*60+parseInt(parts[1]);
      var isPast=tMin<nowTotal&&date===todayStr;
      var isNow=!isPast&&Math.abs(tMin-nowTotal)<=60&&date===todayStr;
      var cls='time-btn'+(isPast?' past':'')+(isNow?' now':'');
      return '<button class="'+cls+'" onclick="event.stopPropagation();">'+cleanT+'</button>';
    }).join('');
    var dur=f.duration?' <span>'+esc(f.duration)+'</span>':'';
    return '<div class="cinema-card"><div class="cinema-card-poster">'+img+'</div><div class="cinema-card-body"><div class="cinema-card-title">'+esc(_l(f,'title'))+'</div><div class="cinema-card-meta">'+langTag+dur+'</div><div class="cinema-card-times">'+times+'</div></div></div>';
  }).join('');
}
function showBuildTime(){
  var ftr=document.querySelector('.ftr-cp');
  if(!ftr)return;
  var meta=document.querySelector('meta[name="build-time"]');
  if(!meta)return;
  var dt=new Date(meta.getAttribute('content'));
  if(!dt.getTime)return;if(isNaN(dt.getTime()))return;
  var now=new Date();
  var hrs=Math.floor((now-dt)/3600000);
  var text=hrs<1?"<1h":hrs<24?hrs+"h":Math.floor(hrs/24)+"j";
  ftr.textContent+=" \u00b7 "+text;
  if(hrs>48){
    var sw=document.getElementById('stale-warning');
    if(sw)sw.style.display='block';
  }
}
function init(){
setTimeout(function(){var pl=document.getElementById("preloader");if(pl)pl.classList.add("hidden");},800);
window.addEventListener("scroll",function(){var nav=document.getElementById("nav");if(nav)nav.classList.toggle("scrolled",window.scrollY>60);var btt=document.getElementById("btt");if(btt)btt.classList.toggle("show",window.scrollY>600);});
document.getElementById("hamburger").addEventListener("click",function(){document.getElementById("nav-links").classList.toggle("open");});
document.getElementById("btt").addEventListener("click",function(){window.scrollTo({top:0,behavior:"smooth"});});
document.getElementById("theme-btn").addEventListener("click",toggleTheme);
document.getElementById("locale-sel").addEventListener("change",function(){LOCALE=this.value;localStorage.setItem(LOCALE_KEY,LOCALE);applyCine();renderCinemaDays(getCinemaFilms());renderCinemaGrid(document.getElementById('cinema-grid').dataset.date);});
applyTheme();applyCine();
var films=getCinemaFilms();
var dates=getCinemaDates(films);
var todayStr=new Date().toISOString().split('T')[0];
var targetDate=dates.indexOf(todayStr)>=0?todayStr:dates[0]||todayStr;
renderCinemaDays(films);
renderCinemaGrid(targetDate);
showBuildTime();
}
function toggleTheme(){var on=document.documentElement.classList.toggle('light');try{localStorage.setItem('chx-theme',on?'light':'dark');}catch(_){}}
function applyTheme(){try{var s=localStorage.getItem('chx-theme');if(s==='light')document.documentElement.classList.add('light');}catch(_){}}
document.addEventListener("DOMContentLoaded",init);
</script>
</body></html>
